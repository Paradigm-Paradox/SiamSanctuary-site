---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
  articleModifiedTime?: string;
}

const {
  title = "Home - DreamNails.Asia",
  description = "Creative Manicure Relaxing Paraffin Spa Soothing Pedicure nail fashion Art Manicure Creative color styles. Always in trend. Best quality.",
  image = "/images/2022/01/serv_01_02-800x800.jpg",
  canonical,
  type = "website",
  articleModifiedTime = "2024-01-16T22:22:07+00:00"
} = Astro.props;

const siteUrl = "https://dreamnails.asia";
const pathname = Astro.url.pathname.replace(/\/index\.html$/, '').replace(/\/$/, '') || '';
const canonicalUrl = canonical || (pathname ? `${siteUrl}${pathname}/` : `${siteUrl}/`);
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://dreamnails.asia/#website",
      "url": "https://dreamnails.asia/",
      "name": "DreamNails.Asia",
      "description": "Perfection in Every Brush",
      "potentialAction": [
        {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://dreamnails.asia/gallery?s={search_term_string}"
          },
          "query-input": {
            "@type": "PropertyValueSpecification",
            "valueRequired": true,
            "valueName": "search_term_string"
          }
        }
      ],
      "inLanguage": "en-US"
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "isPartOf": {
        "@id": "https://dreamnails.asia/#website"
      },
      "primaryImageOfPage": {
        "@id": "https://dreamnails.asia/#primaryimage"
      },
      "image": {
        "@id": "https://dreamnails.asia/#primaryimage"
      },
      "thumbnailUrl": fullImageUrl,
      "datePublished": "2022-01-21T21:24:31+00:00",
      "dateModified": articleModifiedTime,
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "inLanguage": "en-US"
    },
    {
      "@type": "ImageObject",
      "inLanguage": "en-US",
      "@id": "https://dreamnails.asia/#primaryimage",
      "url": fullImageUrl,
      "contentUrl": fullImageUrl,
      "width": 1920,
      "height": 1920
    },
    {
      "@type": ["BeautySalon", "NailSalon"],
      "@id": "https://dreamnails.asia/#salon",
      "name": "DreamNails.Asia",
      "url": "https://dreamnails.asia/",
      "logo": "https://dreamnails.asia/images/2022/03/cropped-icon.png",
      "image": fullImageUrl,
      "telephone": "+1-787-834-8888",
      "priceRange": "$$",
      "description": description,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Mayagüez Mall, 975 Carr 2 Ste 001",
        "addressLocality": "Mayagüez",
        "addressRegion": "PR",
        "postalCode": "00680",
        "addressCountry": "US"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "09:00",
          "closes": "17:00"
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Website Icons (Extracted directly from original site) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/2022/03/cropped-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileImage" content="/mstile-270x270.png" />
    <meta name="msapplication-TileColor" content="#141414" />
    <meta name="theme-color" content="#141414" />

    <!-- Primary Meta & SEO Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="DreamNails.Asia" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:secure_url" content={fullImageUrl} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1920" />
    <meta property="article:modified_time" content={articleModifiedTime} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- FontAwesome fallback CDN for complete glyph set -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  </head>
  <body class="bg-[#141414] text-[#f3f3f3] selection:bg-[#f286aa] selection:text-black">
    <slot />

    <!-- Quick Booking / Inquiry Modal (WCAG 2.1 AA / Section 508 Compliant) -->
    <div 
      id="booking-modal" 
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
      role="dialog"
      aria-modal="true"
      aria-labelledby="booking-modal-title"
    >
      <div class="relative w-full max-w-lg bg-[#1c1c1c] border border-[#d9c1a3]/30 rounded-2xl p-6 sm:p-8 shadow-2xl transform scale-95 transition-transform duration-300 focus:outline-none">
        <button 
          id="close-booking-modal" 
          class="absolute top-4 right-4 text-gray-400 hover:text-white text-2xl leading-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f286aa] rounded p-1"
          aria-label="Close appointment booking dialog"
        >&times;</button>
        <div class="text-center mb-6">
          <span class="font-script text-3xl text-[#f286aa] block" aria-hidden="true">Pamper Yourself</span>
          <h3 id="booking-modal-title" class="text-2xl font-serif text-white uppercase tracking-wider">Book Your Appointment</h3>
          <p class="text-xs text-gray-400 mt-1">Select your preferred salon location or message us directly</p>
        </div>

        <div class="space-y-3 mb-6">
          <a href="https://fb.com/book/DreamNails.Asia/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3.5 rounded-xl bg-[#252525] hover:bg-[#2e2e2e] border border-white/5 hover:border-[#f286aa]/40 transition group focus-visible:ring-2 focus-visible:ring-[#f286aa]">
            <div class="flex items-center gap-3">
              <i class="fab fa-facebook-messenger text-xl text-[#f286aa]" aria-hidden="true"></i>
              <div class="text-left">
                <div class="text-sm font-semibold text-white">Direct Online Booking</div>
                <div class="text-xs text-gray-400">Instant scheduling via DreamNails official portal</div>
              </div>
            </div>
            <i class="fas fa-chevron-right text-xs text-gray-500 group-hover:text-white group-hover:translate-x-1 transition" aria-hidden="true"></i>
          </a>

          <a href="mailto:info.maz@dreamnails.asia" class="flex items-center justify-between p-3.5 rounded-xl bg-[#252525] hover:bg-[#2e2e2e] border border-white/5 hover:border-[#d9c1a3]/40 transition group focus-visible:ring-2 focus-visible:ring-[#d9c1a3]">
            <div class="flex items-center gap-3">
              <i class="fas fa-map-marker-alt text-lg text-[#d9c1a3]" aria-hidden="true"></i>
              <div class="text-left">
                <div class="text-sm font-semibold text-white">Mayagüez, Puerto Rico</div>
                <div class="text-xs text-gray-400">info.maz@dreamnails.asia</div>
              </div>
            </div>
            <span class="text-xs text-[#d9c1a3] font-medium">Email Salon</span>
          </a>

          <a href="mailto:info.hkt@dreamnails.asia" class="flex items-center justify-between p-3.5 rounded-xl bg-[#252525] hover:bg-[#2e2e2e] border border-white/5 hover:border-[#d9c1a3]/40 transition group focus-visible:ring-2 focus-visible:ring-[#d9c1a3]">
            <div class="flex items-center gap-3">
              <i class="fas fa-map-marker-alt text-lg text-[#d9c1a3]" aria-hidden="true"></i>
              <div class="text-left">
                <div class="text-sm font-semibold text-white">Phuket, Thailand</div>
                <div class="text-xs text-gray-400">info.hkt@dreamnails.asia</div>
              </div>
            </div>
            <span class="text-xs text-[#d9c1a3] font-medium">Email Salon</span>
          </a>

          <a href="mailto:info.pty@dreamnails.asia" class="flex items-center justify-between p-3.5 rounded-xl bg-[#252525] hover:bg-[#2e2e2e] border border-white/5 hover:border-[#d9c1a3]/40 transition group focus-visible:ring-2 focus-visible:ring-[#d9c1a3]">
            <div class="flex items-center gap-3">
              <i class="fas fa-map-marker-alt text-lg text-[#d9c1a3]" aria-hidden="true"></i>
              <div class="text-left">
                <div class="text-sm font-semibold text-white">Pattaya, Thailand</div>
                <div class="text-xs text-gray-400">info.pty@dreamnails.asia</div>
              </div>
            </div>
            <span class="text-xs text-[#d9c1a3] font-medium">Email Salon</span>
          </a>
        </div>

        <div class="text-center pt-2 border-t border-white/10">
          <p class="text-xs text-gray-400">For general questions or global franchise inquiries: <a href="mailto:info@dreamnails.asia" class="text-[#f286aa] underline focus-visible:ring-1 focus-visible:ring-[#f286aa]">info@dreamnails.asia</a></p>
        </div>
      </div>
    </div>

    <script is:inline>
      // Booking Modal Triggers with Full Keyboard & Accessibility Support
      function setupBookingModal() {
        const modal = document.getElementById('booking-modal');
        const closeBtn = document.getElementById('close-booking-modal');
        const triggers = document.querySelectorAll('.open-booking-modal');

        if (!modal) return;

        function openModal(e) {
          if (e) e.preventDefault();
          modal.classList.remove('opacity-0', 'pointer-events-none');
          const panel = modal.querySelector('div');
          if (panel) panel.classList.remove('scale-95');
          if (closeBtn) closeBtn.focus();
        }

        function closeModal() {
          modal.classList.add('opacity-0', 'pointer-events-none');
          const panel = modal.querySelector('div');
          if (panel) panel.classList.add('scale-95');
        }

        triggers.forEach(btn => btn.addEventListener('click', openModal));
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
            closeModal();
          }
        });
      }

      document.addEventListener('DOMContentLoaded', setupBookingModal);
    </script>
  </body>
</html>
