---
import '../styles/global.css';
import locations from '../data/locations.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
  articleModifiedTime?: string;
}

const {
  title = "Siam Sanctuary | Full-Service Luxury Salon & Spa",
  description = "Siam Sanctuary is a global full-service luxury beauty salon and spa sanctuary offering bespoke hairstyling, Japanese head spa, couture nail care, lashes, PMU cosmetic tattooing, and rejuvenating facials.",
  image = "/images/2022/01/serv_01_02-800x800.jpg",
  canonical,
  type = "website",
  articleModifiedTime = "2024-01-16T22:22:07+00:00"
} = Astro.props;

const siteUrl = "https://siamsanctuary.asia";
const pathname = Astro.url.pathname.replace(/\/index\.html$/, '').replace(/\/$/, '') || '';
const canonicalUrl = canonical || (pathname ? `${siteUrl}${pathname}/` : `${siteUrl}/`);
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://siamsanctuary.asia/#website",
      "url": "https://siamsanctuary.asia/",
      "name": "Siam Sanctuary",
      "description": "Full-Service Luxury Beauty Salon & Spa Destination",
      "potentialAction": [
        {
          "@type": "SearchAction",
          "target": {
            "@type": "EntryPoint",
            "urlTemplate": "https://siamsanctuary.asia/gallery?s={search_term_string}"
          },
          "query-input": {
            "@type": "PropertyValueSpecification",
            "valueRequired": true,
            "valueName": "search_term_string"
          }
        }
      ],
      "inLanguage": "en-US"
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "isPartOf": {
        "@id": "https://siamsanctuary.asia/#website"
      },
      "primaryImageOfPage": {
        "@id": "https://siamsanctuary.asia/#primaryimage"
      },
      "image": {
        "@id": "https://siamsanctuary.asia/#primaryimage"
      },
      "thumbnailUrl": fullImageUrl,
      "datePublished": "2022-01-21T21:24:31+00:00",
      "dateModified": articleModifiedTime,
      "breadcrumb": {
        "@id": `${canonicalUrl}#breadcrumb`
      },
      "inLanguage": "en-US"
    },
    {
      "@type": "ImageObject",
      "inLanguage": "en-US",
      "@id": "https://siamsanctuary.asia/#primaryimage",
      "url": fullImageUrl,
      "contentUrl": fullImageUrl,
      "width": 1920,
      "height": 1920
    },
    {
      "@type": ["BeautySalon", "HairSalon", "DaySpa", "NailSalon"],
      "@id": "https://siamsanctuary.asia/#salon",
      "name": "Siam Sanctuary",
      "url": "https://siamsanctuary.asia/",
      "logo": "https://siamsanctuary.asia/images/2022/03/cropped-icon.png",
      "image": fullImageUrl,
      "telephone": "+1-787-834-8888",
      "priceRange": "$$",
      "description": description,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Mayagüez Mall, 975 Carr 2 Ste 001",
        "addressLocality": "Mayagüez",
        "addressRegion": "PR",
        "postalCode": "00680",
        "addressCountry": "US"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "09:00",
          "closes": "17:00"
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Website Icons (Extracted directly from original site) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/2022/03/cropped-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileImage" content="/mstile-270x270.png" />
    <meta name="msapplication-TileColor" content="#141414" />
    <meta name="theme-color" content="#141414" />

    <!-- Primary Meta & SEO Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="DreamNails.Asia" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:secure_url" content={fullImageUrl} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1920" />
    <meta property="article:modified_time" content={articleModifiedTime} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- FontAwesome fallback CDN for complete glyph set -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  </head>
  <body class="bg-[#141414] text-[#f3f3f3] selection:bg-[#f286aa] selection:text-black">
    <slot />

    <!-- Quick Booking / Inquiry Modal (WCAG 2.1 AA / Section 508 Compliant) -->
    <div 
      id="booking-modal" 
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
      role="dialog"
      aria-modal="true"
      aria-labelledby="booking-modal-title"
    >
      <div class="relative w-full max-w-lg bg-[#1c1c1c] border border-[#d9c1a3]/30 rounded-2xl p-6 sm:p-8 shadow-2xl transform scale-95 transition-transform duration-300 focus:outline-none">
        <button 
          id="close-booking-modal" 
          class="absolute top-4 right-4 text-gray-400 hover:text-white text-2xl leading-none focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f286aa] rounded p-1"
          aria-label="Close appointment booking dialog"
        >&times;</button>
        <div class="text-center mb-6">
          <span class="font-script text-3xl text-[#f286aa] block" aria-hidden="true">Pamper Yourself</span>
          <h3 id="booking-modal-title" class="text-2xl font-serif text-white uppercase tracking-wider">Book Your Appointment</h3>
          <p class="text-xs text-gray-400 mt-1">Select your preferred salon location or message us directly</p>
        </div>

        <div class="space-y-2.5 max-h-[380px] overflow-y-auto pr-1 mb-6">
          <a href="https://fb.com/book/DreamNails.Asia/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3.5 rounded-xl bg-[#252525] hover:bg-[#2e2e2e] border border-white/5 hover:border-[#f286aa]/40 transition group focus-visible:ring-2 focus-visible:ring-[#f286aa]">
            <div class="flex items-center gap-3">
              <i class="fab fa-facebook-messenger text-xl text-[#f286aa]" aria-hidden="true"></i>
              <div class="text-left">
                <div class="text-sm font-semibold text-white">Direct Online Booking</div>
                <div class="text-xs text-gray-400">Instant scheduling via DreamNails official portal</div>
              </div>
            </div>
            <i class="fas fa-chevron-right text-xs text-gray-500 group-hover:text-white group-hover:translate-x-1 transition" aria-hidden="true"></i>
          </a>

          {locations.map((loc) => (
            <a href={`mailto:${loc.email}?subject=Booking%20Inquiry%20-%20${loc.city}`} class="flex items-center justify-between p-3 rounded-xl bg-[#202020] hover:bg-[#282828] border border-white/5 hover:border-[#d9c1a3]/40 transition group focus-visible:ring-2 focus-visible:ring-[#d9c1a3]">
              <div class="flex items-center gap-3">
                <i class="fas fa-map-marker-alt text-sm text-[#d9c1a3]" aria-hidden="true"></i>
                <div class="text-left">
                  <div class="text-xs font-semibold text-white">{loc.name || `${loc.city}, ${loc.country}`}</div>
                  <div class="text-[11px] text-gray-400">{loc.email}</div>
                </div>
              </div>
              <span class="text-[11px] text-[#d9c1a3] font-medium group-hover:text-[#f286aa] transition">Email Salon &rarr;</span>
            </a>
          ))}
        </div>

        <div class="text-center pt-2 border-t border-white/10">
          <p class="text-xs text-gray-400">For general questions or global franchise inquiries: <a href="mailto:info@siamsanctuary.asia" class="text-[#f286aa] underline focus-visible:ring-1 focus-visible:ring-[#f286aa]">info@siamsanctuary.asia</a></p>
        </div>
      </div>
    </div>

    <!-- Luxury Floating Back-to-Top Button with Circular Scroll Progress -->
    <div id="back-to-top-wrap" class="fixed bottom-6 right-6 z-40 opacity-0 pointer-events-none transition-all duration-300 transform translate-y-3">
      <button 
        id="back-to-top-btn" 
        class="relative w-12 h-12 rounded-full bg-[#181818]/90 hover:bg-[#f286aa] text-white hover:text-black border border-white/10 flex items-center justify-center shadow-2xl backdrop-blur-md transition-colors cursor-pointer group focus-visible:ring-2 focus-visible:ring-[#f286aa]" 
        aria-label="Scroll back to top of page"
      >
        <!-- Circular Progress Ring SVG -->
        <svg class="absolute inset-0 w-12 h-12 -rotate-90 pointer-events-none" viewBox="0 0 48 48">
          <circle cx="24" cy="24" r="20" class="stroke-white/10 fill-none" stroke-width="2"></circle>
          <circle id="scroll-progress-circle" cx="24" cy="24" r="20" class="stroke-[#f286aa] fill-none transition-all duration-75" stroke-width="2" stroke-dasharray="125.6" stroke-dashoffset="125.6"></circle>
        </svg>
        <i class="fas fa-chevron-up text-xs transform group-hover:-translate-y-0.5 transition-transform" aria-hidden="true"></i>
      </button>
    </div>

    <script is:inline>
      // Booking Modal Triggers with Full Keyboard & Accessibility Support
      function setupBookingModal() {
        const modal = document.getElementById('booking-modal');
        const closeBtn = document.getElementById('close-booking-modal');
        const triggers = document.querySelectorAll('.open-booking-modal');

        if (!modal) return;

        function openModal(e) {
          if (e) e.preventDefault();
          modal.classList.remove('opacity-0', 'pointer-events-none');
          const panel = modal.querySelector('div');
          if (panel) panel.classList.remove('scale-95');
          if (closeBtn) closeBtn.focus();
        }

        function closeModal() {
          modal.classList.add('opacity-0', 'pointer-events-none');
          const panel = modal.querySelector('div');
          if (panel) panel.classList.add('scale-95');
        }

        triggers.forEach(btn => btn.addEventListener('click', openModal));
        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
            closeModal();
          }
        });
      }

      // Smooth Back-to-Top Button & Scroll Progress Ring
      function setupScrollEngines() {
        const bttWrap = document.getElementById('back-to-top-wrap');
        const bttBtn = document.getElementById('back-to-top-btn');
        const circle = document.getElementById('scroll-progress-circle');
        const nav = document.querySelector('header nav');
        const circumference = 2 * Math.PI * 20; // 125.66

        function onScroll() {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          
          // Sticky header glass effect
          if (nav) {
            if (scrollTop > 60) {
              nav.classList.add('nav-scrolled');
            } else {
              nav.classList.remove('nav-scrolled');
            }
          }

          // Back to top visibility & progress
          if (bttWrap && circle) {
            if (scrollTop > 280) {
              bttWrap.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
            } else {
              bttWrap.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
            }

            if (scrollHeight > 0) {
              const progress = Math.min(Math.max(scrollTop / scrollHeight, 0), 1);
              circle.style.strokeDashoffset = (circumference * (1 - progress)).toString();
            }
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        if (bttBtn) {
          bttBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // REA IntersectionObserver Scroll Reveal Engine
        const revealElements = document.querySelectorAll('.reveal-on-scroll, .reveal-scale');
        if ('IntersectionObserver' in window && revealElements.length > 0) {
          const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                obs.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px'
          });

          revealElements.forEach(el => observer.observe(el));
        } else {
          // Fallback if IntersectionObserver is unsupported
          revealElements.forEach(el => el.classList.add('is-revealed'));
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        setupBookingModal();
        setupScrollEngines();
      });
    </script>
  </body>
</html>
