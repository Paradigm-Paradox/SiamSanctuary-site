---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServicesMenu from '../components/ServicesMenu.astro';
import services from '../data/services.json';
---

<Layout 
  title="All Salon Services & Treatments | DreamNails.Asia"
  description="Explore all 13 luxury services at Dream Nails Asia: Russian manicures, restorative pedicures, PMU cosmetic tattoos, Japanese head spa, Thai massages, hair styling, bridal makeup, and VIP packages."
>
  <div class="min-h-screen flex flex-col bg-[#141414]">
    <Header />
    
    <main class="flex-grow">
      <!-- Subpage Header Banner -->
      <section class="relative py-24 sm:py-28 bg-[#101010] border-b border-white/5 overflow-hidden">
        <div class="absolute inset-0 opacity-25">
          <img src="/images/2021/12/inner_header_01.jpg" alt="Services Header" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#141414]/85 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
          <span class="font-script text-3xl sm:text-5xl text-[#f286aa] block mb-2">Sanctuary Offerings</span>
          <h1 class="text-4xl sm:text-6xl font-serif text-white uppercase tracking-wider mb-4">
            Services & Treatments
          </h1>
          <p class="text-xs sm:text-sm uppercase tracking-widest text-[#d9c1a3] mb-6">
            13 Bespoke Disciplines • Hospital-Grade Disinfection • Master Craftsmanship
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-gray-300">
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 flex items-center gap-1.5">
              <i class="fas fa-certificate text-[#f286aa]"></i> Medical Autoclave Sterilization
            </span>
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 flex items-center gap-1.5">
              <i class="fas fa-sparkles text-[#f286aa]"></i> Synchronized Multi-Tech Sessions
            </span>
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 flex items-center gap-1.5">
              <i class="fas fa-leaf text-[#f286aa]"></i> Non-Toxic & Cruelty-Free
            </span>
          </div>
        </div>
      </section>

      <!-- 13 Comprehensive Services Grid -->
      <section class="py-20 bg-[#161616]" id="service-catalog">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="font-script text-3xl text-[#f286aa] block mb-1">Our Dedicated Disciplines</span>
            <h2 class="text-3xl sm:text-4xl font-serif text-white uppercase tracking-wider mb-4">
              Explore All 13 Signature Services
            </h2>
            <p class="text-sm text-gray-400 font-light max-w-xl mx-auto">
              Select any discipline below to view complete sub-treatment options, exact pricing in Thai Baht and USD, durations, and clinical hygiene protocols.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {services.map((svc) => (
              <div class="rounded-3xl bg-[#1a1a1a] border border-white/5 hover:border-[#f286aa]/40 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-black/70 group flex flex-col justify-between overflow-hidden">
                <!-- Image Header with Tag & Icon -->
                <div class="relative h-52 overflow-hidden bg-black">
                  <img 
                    src={svc.image} 
                    alt={svc.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-85 group-hover:opacity-100" 
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a] via-transparent to-black/40"></div>
                  
                  <!-- Tag & New Badge -->
                  <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
                    <span class="text-[10px] uppercase tracking-widest text-[#d9c1a3] font-semibold bg-black/70 backdrop-blur-md px-3 py-1 rounded-full border border-white/10">
                      {svc.tag}
                    </span>
                    {svc.slug === 'cosmetic-tattoo-pmu' || svc.slug === 'hair-treatments-head-spa' || svc.slug === 'packages-vip' ? (
                      <span class="text-[10px] uppercase font-bold tracking-wider text-black bg-[#f286aa] px-2.5 py-0.5 rounded-full shadow-lg">
                        New
                      </span>
                    ) : null}
                  </div>

                  <!-- Floating Category Icon -->
                  <div class="absolute bottom-4 left-4 w-12 h-12 rounded-2xl bg-[#141414]/90 backdrop-blur-md text-[#f286aa] border border-white/10 flex items-center justify-center text-xl group-hover:bg-[#f286aa] group-hover:text-black transition-colors shadow-lg">
                    <i class={`fas ${svc.icon}`}></i>
                  </div>
                </div>

                <!-- Body Content -->
                <div class="p-6 flex-1 flex flex-col justify-between">
                  <div>
                    <h3 class="text-2xl font-serif text-white group-hover:text-[#f286aa] transition mb-3">
                      <a href={`/services/${svc.slug}`}>
                        {svc.title}
                      </a>
                    </h3>

                    <p class="text-xs text-gray-400 font-light leading-relaxed mb-5">
                      {svc.excerpt || svc.description}
                    </p>

                    <!-- Key Treatment Highlight Tags -->
                    {svc.treatments && (
                      <div class="mb-5">
                        <span class="text-[10px] uppercase tracking-widest text-gray-500 block mb-2 font-medium">Sample Offerings:</span>
                        <div class="flex flex-wrap gap-1.5">
                          {svc.treatments.slice(0, 3).map((t) => (
                            <span class="text-[11px] bg-white/5 border border-white/10 text-gray-300 px-2.5 py-0.5 rounded-md">
                              {t.name}
                            </span>
                          ))}
                          {svc.treatments.length > 3 && (
                            <span class="text-[11px] text-[#f286aa] px-1 py-0.5 font-medium">
                              +{svc.treatments.length - 3} more
                            </span>
                          )}
                        </div>
                      </div>
                    )}
                  </div>

                  <!-- Action Links -->
                  <div class="pt-5 border-t border-white/5 flex items-center justify-between mt-auto">
                    <a 
                      href={`/services/${svc.slug}`} 
                      class="text-xs font-semibold uppercase tracking-wider text-[#f286aa] hover:text-white transition flex items-center gap-1.5 group/btn"
                    >
                      <span>View Menu & Details</span>
                      <i class="fas fa-arrow-right text-[10px] group-hover/btn:translate-x-1 transition-transform"></i>
                    </a>

                    <button 
                      class="open-booking-modal text-xs uppercase tracking-wider text-gray-400 hover:text-[#d9c1a3] transition cursor-pointer"
                    >
                      Book Now &rarr;
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>

        </div>
      </section>

      <!-- Signature Popular Pricing Menu -->
      <ServicesMenu />

    </main>

    <Footer />
  </div>
</Layout>
