---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="About Us | Dream Salon Asia - Joey & Onanong Jones"
  description="Learn about the founders, vision, and hospital-grade sterilization standards of Dream Salon Asia. Full-service luxury salon & spa founded in Phuket, Thailand and expanding worldwide."
>
  <div class="min-h-screen flex flex-col bg-[#141414]">
    <Header />
    
    <main class="flex-grow">
      <!-- Subpage Header Banner -->
      <section class="relative py-24 bg-[#101010] border-b border-white/5 overflow-hidden">
        <div class="absolute inset-0 opacity-20">
          <img src="/images/2021/12/inner_header_01.jpg" alt="About Header Background" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#141414]/80 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
          <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-2">Our Journey & Mission</span>
          <h1 class="text-4xl sm:text-6xl font-serif text-white uppercase tracking-wider mb-4">
            About Dream Salon
          </h1>
          <p class="text-xs sm:text-sm uppercase tracking-widest text-[#d9c1a3]">
            Founded by Joey & Onanong Jones • Phuket, Thailand to the World
          </p>
        </div>
      </section>

      <!-- Main Story Section -->
      <section class="py-20 bg-[#181818]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-20">
            <div>
              <span class="font-script text-3xl text-[#f286aa] block mb-1">Empowering Beauty</span>
              <h2 class="text-3xl sm:text-4xl font-serif text-white uppercase tracking-wide mb-6">
                Where Confidence & Sophistication Begin
              </h2>
              <div class="space-y-4 text-sm sm:text-base text-gray-300 font-light leading-relaxed">
                <p>
                  Welcome to <strong class="text-white font-medium">Dream Salon Asia</strong>, your global full-service luxury beauty salon and spa destination. We believe that beauty is much more than an aesthetic experience—it is a personal movement. Our core purpose is to empower individuals worldwide by providing an all-inclusive sanctuary where bespoke hair design, Japanese head spa rituals, facial wellness, lash & brow PMU, and couture nail artistry come together.
                </p>
                <p>
                  Our journey originated in the picture-perfect tropical paradise of <strong class="text-white">Phuket, Thailand</strong>. With over a decade and a half in the luxury beauty industry, our master stylists, licensed aestheticians, and certified nail artists have built an acclaimed international reputation for excellence across hair, skin, and nail care. Throughout the years, we have had the honor of styling local and international clients, models, and travelers seeking perfection.
                </p>
                <p class="italic text-[#d9c1a3] font-serif text-base border-l-2 border-[#f286aa] pl-4 my-4">
                  "We believe that when you look good and feel good, you do good. When women support and inspire each other, truly magical things happen."
                </p>
              </div>
            </div>

            <div class="relative">
              <div class="rounded-2xl overflow-hidden border border-[#d9c1a3]/20 shadow-2xl">
                <img src="/images/2021/12/about_sidebar.jpg" alt="Dream Nails Sanctuary Experience" class="w-full h-auto object-cover" />
              </div>
            </div>
          </div>

          <!-- Hospital-Grade Sanitation Pillar -->
          <div class="bg-[#121212] rounded-3xl p-8 sm:p-12 border border-white/5 shadow-2xl mb-20">
            <div class="max-w-3xl mx-auto text-center mb-10">
              <span class="font-script text-3xl text-[#f286aa] block mb-1">Our Safety Commitment</span>
              <h2 class="text-3xl sm:text-4xl font-serif text-white uppercase tracking-wider mb-4">
                Hospital-Grade Sanitation Standards
              </h2>
              <p class="text-sm text-gray-400 font-light max-w-xl mx-auto">
                Cleanliness and clinical safety are our highest non-negotiable priorities. We implement hospital-grade sterilization exceeding international health board and OSHA regulations across every salon worldwide.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-10">
              <div class="p-6 rounded-2xl bg-[#1a1a1a] border border-white/5 text-center flex flex-col justify-between">
                <div>
                  <div class="w-14 h-14 rounded-full bg-[#f286aa]/10 text-[#f286aa] flex items-center justify-center text-2xl mx-auto mb-4">
                    <i class="fas fa-pump-medical"></i>
                  </div>
                  <h3 class="text-base font-serif text-white uppercase mb-2">Class-B Medical Autoclave</h3>
                  <p class="text-xs text-gray-400 font-light leading-relaxed">
                    All metal tools undergo ultrasonic enzymatic cleaning and steam sterilization at 275°F (135°C), sealed in indicator pouches opened in your presence.
                  </p>
                </div>
              </div>

              <div class="p-6 rounded-2xl bg-[#1a1a1a] border border-white/5 text-center flex flex-col justify-between">
                <div>
                  <div class="w-14 h-14 rounded-full bg-[#d9c1a3]/10 text-[#d9c1a3] flex items-center justify-center text-2xl mx-auto mb-4">
                    <i class="fas fa-trash-arrow-up"></i>
                  </div>
                  <h3 class="text-base font-serif text-white uppercase mb-2">100% Single-Use Disposables</h3>
                  <p class="text-xs text-gray-400 font-light leading-relaxed">
                    Nail files, buffers, wooden sticks, pedicure tub liners, and waxing spatulas (strictly zero double-dipping) are discarded immediately after each client.
                  </p>
                </div>
              </div>

              <div class="p-6 rounded-2xl bg-[#1a1a1a] border border-white/5 text-center flex flex-col justify-between">
                <div>
                  <div class="w-14 h-14 rounded-full bg-[#38bdf8]/10 text-[#38bdf8] flex items-center justify-center text-2xl mx-auto mb-4">
                    <i class="fas fa-water"></i>
                  </div>
                  <h3 class="text-base font-serif text-white uppercase mb-2">Pipeless Ozone Hydrotherapy</h3>
                  <p class="text-xs text-gray-400 font-light leading-relaxed">
                    Direct-drive magnetic jet basins with zero internal pipes, eliminating biofilm and bacterial recirculation for completely pure foot and scalp therapy.
                  </p>
                </div>
              </div>

              <div class="p-6 rounded-2xl bg-[#1a1a1a] border border-white/5 text-center flex flex-col justify-between">
                <div>
                  <div class="w-14 h-14 rounded-full bg-[#ec4899]/10 text-[#ec4899] flex items-center justify-center text-2xl mx-auto mb-4">
                    <i class="fas fa-spray-can-sparkles"></i>
                  </div>
                  <h3 class="text-base font-serif text-white uppercase mb-2">EPA Hospital Disinfection</h3>
                  <p class="text-xs text-gray-400 font-light leading-relaxed">
                    Styling chairs, head spa beds, manicure stations, and LED lamps are thoroughly sanitized with broad-spectrum virucides and bactericides between guests.
                  </p>
                </div>
              </div>

              <div class="p-6 rounded-2xl bg-[#1a1a1a] border border-white/5 text-center flex flex-col justify-between">
                <div>
                  <div class="w-14 h-14 rounded-full bg-[#a855f7]/10 text-[#a855f7] flex items-center justify-center text-2xl mx-auto mb-4">
                    <i class="fas fa-wind"></i>
                  </div>
                  <h3 class="text-base font-serif text-white uppercase mb-2">HEPA-13 Air Filtration</h3>
                  <p class="text-xs text-gray-400 font-light leading-relaxed">
                    Source-capture dust extraction tables and medical-grade HEPA-13 carbon air purifiers continuously remove airborne keratin dust, vapors, and aerosols.
                  </p>
                </div>
              </div>

              <div class="p-6 rounded-2xl bg-[#1a1a1a] border border-white/5 text-center flex flex-col justify-between">
                <div>
                  <div class="w-14 h-14 rounded-full bg-[#42bf80]/10 text-[#42bf80] flex items-center justify-center text-2xl mx-auto mb-4">
                    <i class="fas fa-certificate"></i>
                  </div>
                  <h3 class="text-base font-serif text-white uppercase mb-2">Certified & Licensed Masters</h3>
                  <p class="text-xs text-gray-400 font-light leading-relaxed">
                    Every stylist, aesthetician, and artist maintains professional licensing and undergoes continuous advanced hygiene, PMU aseptic, and trichology certification.
                  </p>
                </div>
              </div>
            </div>

            <div class="text-center pt-6 border-t border-white/5">
              <a href="/sanitation-standards" class="btn-luxury-primary text-xs inline-flex items-center gap-2">
                <span>View Full Sanitation Charter & Step-by-Step Process</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              </a>
            </div>
          </div>

          <!-- Customer Gratitude Section -->
          <div class="text-center max-w-2xl mx-auto">
            <h3 class="text-2xl font-serif text-white uppercase mb-3">A Message From Joey & Onanong</h3>
            <p class="text-sm text-gray-300 font-light leading-relaxed mb-6">
              "We at DreamNails.Asia want to say a massive thank you to all our supporters, friends, and customers worldwide. You have made this dream a reality, and we cannot wait to welcome you to our sanctuaries."
            </p>
            <button class="open-booking-modal btn-luxury-primary text-xs cursor-pointer">
              <span>Book An Appointment With Us</span>
            </button>
          </div>

        </div>
      </section>

    </main>

    <Footer />
  </div>
</Layout>
