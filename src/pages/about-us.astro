---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="About Us | DreamNails.Asia - Joey & Onanong Jones"
  description="Learn about the founders, vision, and hospital-grade sterilization standards of Dream Nails Asia. Founded in Phuket, Thailand and expanding worldwide."
>
  <div class="min-h-screen flex flex-col bg-[#141414]">
    <Header />
    
    <main class="flex-grow">
      <!-- Subpage Header Banner -->
      <section class="relative py-24 bg-[#101010] border-b border-white/5 overflow-hidden">
        <div class="absolute inset-0 opacity-20">
          <img src="/uploads/2021/12/inner_header_01.jpg" alt="About Header Background" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#141414]/80 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
          <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-2">Our Journey & Mission</span>
          <h1 class="text-4xl sm:text-6xl font-serif text-white uppercase tracking-wider mb-4">
            About Dream Nails
          </h1>
          <p class="text-xs sm:text-sm uppercase tracking-widest text-[#d9c1a3]">
            Founded by Joey & Onanong Jones • Phuket, Thailand to the World
          </p>
        </div>
      </section>

      <!-- Main Story Section -->
      <section class="py-20 bg-[#181818]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-20">
            <div>
              <span class="font-script text-3xl text-[#f286aa] block mb-1">Empowering Beauty</span>
              <h2 class="text-3xl sm:text-4xl font-serif text-white uppercase tracking-wide mb-6">
                Where Confidence & Sophistication Begin
              </h2>
              <div class="space-y-4 text-sm sm:text-base text-gray-300 font-light leading-relaxed">
                <p>
                  Welcome to <strong class="text-white font-medium">Dream Nails – Asia</strong>, your global nail destination. We believe that beauty is much more than an aesthetic experience—it is a personal movement. Our core purpose is to empower individuals worldwide by providing a welcoming sanctuary where confidence, self-expression, and refined elegance come together.
                </p>
                <p>
                  Our journey originated in the picture-perfect tropical paradise of <strong class="text-white">Phuket, Thailand</strong>. With over a decade and a half in the beauty industry, our seasoned masters have built an acclaimed international reputation for trendsetting nail artistry. Throughout the years, we have had the honor of styling local and international clients, models, and travelers seeking perfection.
                </p>
                <p class="italic text-[#d9c1a3] font-serif text-base border-l-2 border-[#f286aa] pl-4 my-4">
                  "We believe that when you look good and feel good, you do good. When women support and inspire each other, truly magical things happen."
                </p>
              </div>
            </div>

            <div class="relative">
              <div class="rounded-2xl overflow-hidden border border-[#d9c1a3]/20 shadow-2xl">
                <img src="/uploads/2021/12/about_sidebar.jpg" alt="Dream Nails Sanctuary Experience" class="w-full h-auto object-cover" />
              </div>
            </div>
          </div>

          <!-- Hospital-Grade Sanitation Pillar -->
          <div class="bg-[#121212] rounded-3xl p-8 sm:p-12 border border-white/5 shadow-2xl mb-20">
            <div class="max-w-3xl mx-auto text-center mb-10">
              <span class="font-script text-3xl text-[#f286aa] block mb-1">Our Safety Commitment</span>
              <h2 class="text-3xl sm:text-4xl font-serif text-white uppercase tracking-wider mb-4">
                Hospital-Grade Sanitation Standards
              </h2>
              <p class="text-sm text-gray-400 font-light">
                At DreamNails, cleanliness is our highest priority beside your complete delight. We implement clinical medical-grade procedures to ensure your health and safety.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div class="p-6 rounded-2xl bg-[#1a1a1a] border border-white/5 text-center">
                <div class="w-14 h-14 rounded-full bg-[#f286aa]/10 text-[#f286aa] flex items-center justify-center text-2xl mx-auto mb-4">
                  <i class="fas fa-pump-medical"></i>
                </div>
                <h3 class="text-lg font-serif text-white uppercase mb-2">Hospital-Grade Disinfection</h3>
                <p class="text-xs text-gray-400 font-light leading-relaxed">
                  All instruments undergo thorough enzymatic cleaning, medical-grade disinfectant soaks, and autoclave sterilization until opened before you.
                </p>
              </div>

              <div class="p-6 rounded-2xl bg-[#1a1a1a] border border-white/5 text-center">
                <div class="w-14 h-14 rounded-full bg-[#d9c1a3]/10 text-[#d9c1a3] flex items-center justify-center text-2xl mx-auto mb-4">
                  <i class="fas fa-trash-alt"></i>
                </div>
                <h3 class="text-lg font-serif text-white uppercase mb-2">100% Single-Use Disposables</h3>
                <p class="text-xs text-gray-400 font-light leading-relaxed">
                  Buffers, nail files, wooden cuticle pushers, and pedicure tub liners are strictly single-use and disposed of immediately after each client.
                </p>
              </div>

              <div class="p-6 rounded-2xl bg-[#1a1a1a] border border-white/5 text-center">
                <div class="w-14 h-14 rounded-full bg-[#42bf80]/10 text-[#42bf80] flex items-center justify-center text-2xl mx-auto mb-4">
                  <i class="fas fa-certificate"></i>
                </div>
                <h3 class="text-lg font-serif text-white uppercase mb-2">Licensed & Certified Staff</h3>
                <p class="text-xs text-gray-400 font-light leading-relaxed">
                  Every technician holds professional licensing and undergoes continuous advanced education in modern nail anatomy, hygiene, and sculpting.
                </p>
              </div>
            </div>
          </div>

          <!-- Customer Gratitude Section -->
          <div class="text-center max-w-2xl mx-auto">
            <h3 class="text-2xl font-serif text-white uppercase mb-3">A Message From Joey & Onanong</h3>
            <p class="text-sm text-gray-300 font-light leading-relaxed mb-6">
              "We at DreamNails.Asia want to say a massive thank you to all our supporters, friends, and customers worldwide. You have made this dream a reality, and we cannot wait to welcome you to our sanctuaries."
            </p>
            <button class="open-booking-modal btn-luxury-primary text-xs cursor-pointer">
              <span>Book An Appointment With Us</span>
            </button>
          </div>

        </div>
      </section>

    </main>

    <Footer />
  </div>
</Layout>
