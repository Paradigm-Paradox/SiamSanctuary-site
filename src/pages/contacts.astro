---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocationsSection from '../components/LocationsSection.astro';
---

<Layout 
  title="Contact Us & Global Salons | DreamNails.Asia"
  description="Contact Dream Nails Asia salons in Puerto Rico, Thailand, Bali, Dubai, and Cameroon. Find local phone numbers, email addresses, and opening hours."
>
  <div class="min-h-screen flex flex-col bg-[#141414]">
    <Header />
    
    <main class="flex-grow">
      <!-- Header Banner -->
      <section class="relative py-24 bg-[#101010] border-b border-white/5 overflow-hidden">
        <div class="absolute inset-0 opacity-20">
          <img src="/images/2021/12/inner_header_01.jpg" alt="Contacts Header" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#141414]/80 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
          <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-2">Connect With Us</span>
          <h1 class="text-4xl sm:text-6xl font-serif text-white uppercase tracking-wider mb-4">
            Contact & Salon Hubs
          </h1>
          <p class="text-xs sm:text-sm uppercase tracking-widest text-[#d9c1a3]">
            Global Service • Appointments • Inquiries & Partnerships
          </p>
        </div>
      </section>

      <!-- Interactive Global Map (Zero Google API keys, CartoDB Dark Matter / Voyager) -->
      <section class="py-12 bg-[#141414]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="rounded-3xl overflow-hidden border border-white/10 shadow-2xl relative">
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
            <div id="global-salon-map" class="w-full h-[420px] bg-[#111111] z-10"></div>
            
            <div class="absolute bottom-4 left-4 z-20 bg-black/80 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/10 text-xs text-gray-300 pointer-events-none">
              <span class="text-[#f286aa] font-semibold">DreamNails Global Hubs</span> • Click pins to view city details
            </div>
          </div>
        </div>
      </section>

      <!-- 6 Locations Grid -->
      <LocationsSection />

      <!-- Contact Message Form Section -->
      <section class="py-20 bg-[#181818] border-t border-white/5">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="bg-[#121212] rounded-3xl p-8 sm:p-12 border border-white/5 shadow-2xl">
            <div class="text-center max-w-xl mx-auto mb-10">
              <span class="font-script text-3xl text-[#f286aa] block mb-1">Get In Touch</span>
              <h2 class="text-3xl font-serif text-white uppercase tracking-wider mb-2">
                Send Us a Direct Message
              </h2>
              <p class="text-xs text-gray-400 font-light">
                Whether you have a question regarding service treatments, press inquiries, or custom group bookings, we are here to assist.
              </p>
            </div>

            <form action="mailto:info@dreamnails.asia" method="POST" enctype="text/plain" class="space-y-4" aria-label="Contact and inquiry form">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-name" class="block text-xs uppercase tracking-wider text-gray-400 mb-1.5">Your Name <span class="text-[#f286aa]" aria-hidden="true">*</span></label>
                  <input type="text" id="contact-name" name="name" required class="w-full bg-[#1e1e1e] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#f286aa] focus-visible:ring-1 focus-visible:ring-[#f286aa] transition" placeholder="Jane Doe" />
                </div>
                <div>
                  <label for="contact-email" class="block text-xs uppercase tracking-wider text-gray-400 mb-1.5">Email Address <span class="text-[#f286aa]" aria-hidden="true">*</span></label>
                  <input type="email" id="contact-email" name="email" required class="w-full bg-[#1e1e1e] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#f286aa] focus-visible:ring-1 focus-visible:ring-[#f286aa] transition" placeholder="jane@example.com" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-location" class="block text-xs uppercase tracking-wider text-gray-400 mb-1.5">Preferred Location</label>
                  <select id="contact-location" name="location" class="w-full bg-[#1e1e1e] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#f286aa] focus-visible:ring-1 focus-visible:ring-[#f286aa] transition">
                    <option value="Mayaguez">Mayagüez, Puerto Rico</option>
                    <option value="Phuket">Phuket, Thailand</option>
                    <option value="Pattaya">Pattaya, Thailand</option>
                    <option value="Bali">Bali, Indonesia</option>
                    <option value="Dubai">Dubai, UAE</option>
                    <option value="Douala">Douala, Cameroon</option>
                    <option value="General">General / Other</option>
                  </select>
                </div>
                <div>
                  <label for="contact-subject" class="block text-xs uppercase tracking-wider text-gray-400 mb-1.5">Subject</label>
                  <input type="text" id="contact-subject" name="subject" class="w-full bg-[#1e1e1e] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#f286aa] focus-visible:ring-1 focus-visible:ring-[#f286aa] transition" placeholder="Appointment or Inquiry" />
                </div>
              </div>

              <div>
                <label for="contact-message" class="block text-xs uppercase tracking-wider text-gray-400 mb-1.5">Message / Details <span class="text-[#f286aa]" aria-hidden="true">*</span></label>
                <textarea id="contact-message" name="message" rows="4" required class="w-full bg-[#1e1e1e] border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-[#f286aa] focus-visible:ring-1 focus-visible:ring-[#f286aa] transition" placeholder="Tell us how we can help you..."></textarea>
              </div>

              <div class="text-center pt-2">
                <button type="submit" class="btn-luxury-primary text-xs cursor-pointer w-full sm:w-auto focus-visible:ring-2 focus-visible:ring-[#f286aa]">
                  <i class="far fa-paper-plane mr-2" aria-hidden="true"></i>
                  <span>Send Message</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </section>

    </main>

    <Footer />
  </div>
</Layout>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const mapEl = document.getElementById('global-salon-map');
    if (!mapEl || typeof L === 'undefined') return;

    // Center map around world view
    const map = L.map('global-salon-map', { 
      zoomControl: true, 
      scrollWheelZoom: false 
    }).setView([20.0, 30.0], 2);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap & CartoDB',
      maxZoom: 18
    }).addTo(map);

    const locations = [
      { city: "Mayagüez, PR", lat: 18.2013, lng: -67.1452, email: "info.maz@dreamnails.asia" },
      { city: "Phuket, Thailand", lat: 7.8804, lng: 98.3923, email: "info.hkt@dreamnails.asia" },
      { city: "Pattaya, Thailand", lat: 12.9276, lng: 100.8771, email: "info.pty@dreamnails.asia" },
      { city: "Bali, Indonesia", lat: -8.4095, lng: 115.1889, email: "info.dps@dreamnails.asia" },
      { city: "Dubai, UAE", lat: 25.2048, lng: 55.2708, email: "info.uxb@dreamnails.asia" },
      { city: "Douala, Cameroon", lat: 4.0511, lng: 9.7679, email: "info.dla@dreamnails.asia" },
    ];

    locations.forEach(loc => {
      L.marker([loc.lat, loc.lng])
        .addTo(map)
        .bindPopup(`<b>DreamNails – ${loc.city}</b><br><a href="mailto:${loc.email}">${loc.email}</a>`);
    });
  });
</script>
