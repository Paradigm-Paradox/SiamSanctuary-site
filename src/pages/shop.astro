  },
  {
    id: 5,
    name: "Anything is Possible Elixir",
    category: "Serums",
    price: "$119.00",
    image: "/uploads/2021/12/shop-04.jpg",
    description: "Revitalizing youth booster serum infused with botanical antioxidants and rosehip oil to brighten tired skin and promote elastic radiance.",
