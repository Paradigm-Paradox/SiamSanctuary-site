    price: "$190.00",
    image: "/uploads/2021/12/shop-06.jpg",
    description: "Exclusive salon keepsake figurine reflecting tranquility, inner grace, and artistic devotion. Handcrafted collector’s item.",
    tag: "Limited"
  },
  {
    id: 7,
    name: "Nature Care Restorative Package",
    category: "Spa Sets",
    price: "$240.00",
    image: "/uploads/2021/12/shop-07.jpg",
    description: "The complete luxury at-home spa kit: bath minerals, massage oil, body wash, and organic exfoliating scrub packaged in an eco-gift box.",
    tag: "VIP Set"
  },
  {
    id: 8,
    name: "Gentle Wax Cream",
    category: "Nourishment",
    price: "$73.49",
    image: "/uploads/2021/12/shop-08.jpg",
    description: "Ultra-rich conditioning balm designed to seal moisture into dry cuticles, rough elbows, and heels. Enriched with natural beeswax.",
    tag: "Nourishing"
  },
  {
    id: 9,
    name: "Botanical Hand Cream",
    category: "Hand Care",
    price: "$17.99",
    image: "/uploads/2021/12/shop-09.jpg",
    description: "Non-greasy, fast-absorbing hand therapy with shea butter and chamomile extract to protect hands against frequent washing.",
    tag: "Daily Essential"
  },
  {
    id: 10,
    name: "Natural Fresh Deodorant",
    category: "Personal Care",
    price: "$9.99",
    image: "/uploads/2021/12/shop-10.jpg",
