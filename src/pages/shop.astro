    tag: "Clean Beauty"
  },
  {
    id: 11,
    name: "Intensive Cosmetic Cream",
    category: "Skincare",
    price: "$125.00",
    image: "/uploads/2021/12/shop-11.jpg",
    description: "Premium moisture recovery facial and neck cream infused with hyaluronic acid, jojoba oil, and peptide complex for supple firmness.",
    tag: "Anti-Aging"
  },
  {
    id: 12,
    name: "Precision Cosmetic & Nail Brush",
