---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import products from '../data/products.json';
---

<Layout 
  title="Organic Beauty & Nail Care Shop | DreamNails.Asia"
  description="Shop clean, cruelty-free beauty products, handmade craft soaps, nourishing hair balsams, and professional cuticle oils from Dream Nails Asia."
>
  <div class="min-h-screen flex flex-col bg-[#141414]">
    <Header />
    
    <main class="flex-grow">
      <!-- Header Banner -->
      <section class="relative py-24 bg-[#101010] border-b border-white/5 overflow-hidden">
        <div class="absolute inset-0 opacity-20">
          <img src="/uploads/2021/12/inner_header_01.jpg" alt="Shop Header" class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#141414]/80 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">
          <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-2">Clean Botanical Formulations</span>
          <h1 class="text-4xl sm:text-6xl font-serif text-white uppercase tracking-wider mb-4">
            Organic Beauty & Care Shop
          </h1>
          <p class="text-xs sm:text-sm uppercase tracking-widest text-[#d9c1a3]">
            100% Cruelty-Free • Artisan Crafted • Worldwide Shipping & Salon Pickup
          </p>
        </div>
      </section>

      <!-- Products Grid Section -->
      <section class="py-20 bg-[#181818]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-12 pb-6 border-b border-white/10">
            <div>
              <h2 class="text-2xl font-serif text-white uppercase tracking-wide">Featured Collection</h2>
              <p class="text-xs text-gray-400">Showing all 12 organic cosmetics & care essentials</p>
            </div>
            <div class="text-xs text-gray-400 flex items-center gap-2">
              <i class="fas fa-shipping-fast text-[#f286aa]"></i>
              <span>Available for salon pickup or international delivery</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-8">
            {products.map((p) => (
              <div class="rounded-2xl bg-[#141414] border border-white/5 hover:border-[#d9c1a3]/40 p-5 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl group flex flex-col justify-between">
                
                <div>
                  <!-- Product Image -->
                  <div class="relative rounded-xl overflow-hidden aspect-square bg-[#1a1a1a] mb-4 border border-white/5">
                    <img 
                      src={p.image} 
                      alt={p.name} 
                      class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500" 
                      loading="lazy"
                    />
                    <span class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-full text-[10px] uppercase font-semibold tracking-wider bg-black/70 backdrop-blur-md text-[#f286aa] border border-[#f286aa]/30">
                      {p.tag}
                    </span>
                  </div>

                  <!-- Category & Title -->
                  <span class="text-[10px] uppercase tracking-widest text-[#d9c1a3] font-semibold block mb-1">
                    {p.category}
                  </span>
                  <h3 class="text-lg font-serif text-white group-hover:text-[#f286aa] transition mb-2">
                    <a href={`/shop/${p.slug}`} class="hover:underline">{p.name}</a>
                  </h3>
                  <p class="text-xs text-gray-400 font-light leading-relaxed line-clamp-3 mb-4">
                    {p.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                  <span class="text-lg font-serif font-bold text-white">
                    {p.price} <span class="text-[10px] text-gray-500 font-sans font-normal">USD</span>
                  </span>
                  <a 
                    href={`mailto:info@dreamnails.asia?subject=Order%20Inquiry%20-%20${encodeURIComponent(p.name)}&body=Hello%2C%20I%20would%20like%20to%20order%20the%20${encodeURIComponent(p.name)}%20(${p.price}).%20Please%20let%20me%20know%20shipping%20details.`} 
                    class="btn-luxury-primary !py-2 !px-4 text-[11px]"
                  >
                    <span>Order Now</span>
                  </a>
                </div>

              </div>
            ))}
          </div>

          <!-- Customer Service Note -->
          <div class="mt-16 p-8 rounded-2xl bg-[#121212] border border-white/5 text-center max-w-2xl mx-auto">
            <i class="fas fa-leaf text-2xl text-[#42bf80] mb-3"></i>
            <h4 class="text-lg font-serif text-white uppercase mb-2">Custom Orders & Wholesale Inquiries</h4>
            <p class="text-xs text-gray-400 font-light leading-relaxed mb-4">
              Interested in bulk orders, salon gift sets, or retail partnerships? Contact Joey & Onanong Jones directly at <a href="mailto:info@dreamnails.asia" class="text-[#f286aa] underline">info@dreamnails.asia</a>.
            </p>
          </div>

        </div>
      </section>

    </main>

    <Footer />
  </div>
</Layout>
