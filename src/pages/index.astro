---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Philosophy from '../components/Philosophy.astro';
import CosmeticsBanner from '../components/CosmeticsBanner.astro';
import ServicesMenu from '../components/ServicesMenu.astro';
import VideoBanner from '../components/VideoBanner.astro';
import PortfolioGallery from '../components/PortfolioGallery.astro';
import LocationsSection from '../components/LocationsSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Siam Sanctuary | Full-Service Luxury Salon & Spa Destination" 
  description="An exclusive full-service luxury beauty salon and spa destination. Experience bespoke hair styling, Japanese head spa, lash extensions, brow PMU, facials, and couture nail artistry."
>
  <div id="top" class="min-h-screen flex flex-col bg-[#141414]">
    <Header />
    <main class="flex-grow">
      <Hero />
      <Philosophy />
      <CosmeticsBanner />
      <ServicesMenu />
      <VideoBanner />
      <PortfolioGallery />
      <LocationsSection />
    </main>
    <Footer />
  </div>
</Layout>
