---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PromoCards from '../components/PromoCards.astro';
import Philosophy from '../components/Philosophy.astro';
import CosmeticsBanner from '../components/CosmeticsBanner.astro';
import ServicesMenu from '../components/ServicesMenu.astro';
import VideoBanner from '../components/VideoBanner.astro';
import PortfolioGallery from '../components/PortfolioGallery.astro';
import LocationsSection from '../components/LocationsSection.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="DreamNails.Asia | Luxury Nail Sanctuary & Global Beauty Destination" 
  description="Discover trendsetting nail artistry, hospital-grade sanitized manicures, and botanical spa pedicures at Dream Nails Asia. Global salons in Puerto Rico, Thailand, Bali, Dubai & Cameroon."
>
  <div id="top" class="min-h-screen flex flex-col bg-[#141414]">
    <Header />
    <main class="flex-grow">
      <Hero />
      <PromoCards />
      <Philosophy />
      <CosmeticsBanner />
      <ServicesMenu />
      <VideoBanner />
      <PortfolioGallery />
      <LocationsSection />
      <Testimonials />
    </main>
    <Footer />
  </div>
</Layout>
