---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import products from '../../data/products.json';

export async function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p }
  }));
}

const { product } = Astro.props;
---

<Layout 
  title={`${product.name} | DreamNails.Asia Organic Shop`}
  description={product.description}
  image={product.image}
>
  <div class="min-h-screen flex flex-col bg-[#141414]">
    <Header />
    
    <main class="flex-grow py-20 bg-[#181818]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <a href="/shop" class="inline-flex items-center gap-1.5 text-xs uppercase tracking-widest text-[#f286aa] hover:text-white transition mb-8">
          <i class="fas fa-arrow-left text-[10px]"></i>
          <span>Back to All Products</span>
        </a>

        <div class="bg-[#121212] rounded-3xl p-8 sm:p-12 border border-white/5 shadow-2xl">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            
            <!-- Image Showcase -->
            <div class="rounded-2xl overflow-hidden aspect-square bg-[#1a1a1a] border border-white/10 shadow-xl relative group">
              <img src={product.image} alt={product.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <span class="absolute top-4 right-4 px-3 py-1 rounded-full text-xs uppercase font-semibold tracking-wider bg-black/70 backdrop-blur-md text-[#f286aa] border border-[#f286aa]/30">
                {product.category}
              </span>
            </div>

            <!-- Details Column -->
            <div class="space-y-6">
              <div>
                <span class="font-script text-3xl text-[#d9c1a3] block mb-1">Clean Beauty Essential</span>
                <h1 class="text-3xl sm:text-4xl font-serif text-white uppercase tracking-wide leading-tight mb-2">
                  {product.name}
                </h1>
                <div class="text-2xl font-serif font-bold text-[#f286aa]">
                  {product.price} <span class="text-xs text-gray-500 font-sans font-normal">USD</span>
                </div>
              </div>

              <p class="text-sm text-gray-300 font-light leading-relaxed">
                {product.description}
              </p>

              <!-- Feature Checks -->
              <div class="space-y-2.5 text-xs text-gray-300 border-y border-white/10 py-4">
                <div class="flex items-center gap-2">
                  <i class="fas fa-check text-[#42bf80]"></i>
                  <span>100% Cruelty-Free & Plant-Derived</span>
                </div>
                <div class="flex items-center gap-2">
                  <i class="fas fa-check text-[#42bf80]"></i>
                  <span>Available for Salon Pickup or Worldwide Shipping</span>
                </div>
                <div class="flex items-center gap-2">
                  <i class="fas fa-check text-[#42bf80]"></i>
                  <span>Artisan Handcrafted Quality</span>
                </div>
              </div>

              <!-- Order Buttons -->
              <div class="flex items-center gap-4 flex-wrap pt-2">
                <a 
                  href={`mailto:info@dreamnails.asia?subject=Order%20Inquiry%20-%20${encodeURIComponent(product.name)}&body=Hello%2C%20I%20would%20like%20to%20order%20the%20${encodeURIComponent(product.name)}%20(${product.price}).%20Please%20let%20me%20know%20shipping%20details.`} 
                  class="btn-luxury-primary text-xs"
                >
                  <i class="fas fa-shopping-bag mr-2"></i>
                  <span>Order via Email</span>
                </a>
                <a href="/shop" class="btn-luxury-outline text-xs">
                  <span>Browse More Products</span>
                </a>
              </div>

            </div>

          </div>
        </div>

      </div>
    </main>

    <Footer />
  </div>
</Layout>
