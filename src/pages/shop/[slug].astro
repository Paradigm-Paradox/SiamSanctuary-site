---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import products from '../../data/products.json';

export async function getStaticPaths() {
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p }
  }));
}

const { product } = Astro.props;

// Find related products in the same category or overall collection
const relatedProducts = products
  .filter((p) => p.slug !== product.slug)
  .slice(0, 3);
---

<Layout 
  title={`${product.name} | Siam Sanctuary At-Home Rituals`}
  description={product.subtitle || product.description.slice(0, 160)}
  image={product.image}
>
  <div class="min-h-screen flex flex-col bg-[#141414]">
    <Header />
    
    <main class="flex-grow py-16 sm:py-24 bg-[#181818]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs uppercase tracking-widest text-gray-400 mb-10">
          <a href="/shop" class="hover:text-[#f286aa] transition">Shop</a>
          <span>/</span>
          <span class="text-[#d9c1a3]">{product.category}</span>
          <span>/</span>
          <span class="text-white font-medium truncate max-w-[200px] sm:max-w-none">{product.name}</span>
        </nav>

        <!-- Product Card Container -->
        <div class="bg-[#121212] rounded-3xl p-6 sm:p-12 border border-white/5 shadow-2xl mb-16">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
            
            <!-- Left: Image Showcase -->
            <div class="lg:col-span-5 space-y-4">
              <div class="rounded-2xl overflow-hidden aspect-square bg-[#101010] border border-white/10 shadow-xl relative group flex items-center justify-center p-6">
                <img 
                  src={product.image} 
                  alt={product.name} 
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" 
                />
                <span class="absolute top-4 right-4 px-3 py-1 rounded-full text-[10px] uppercase font-semibold tracking-wider bg-black/80 backdrop-blur-md text-[#f286aa] border border-[#f286aa]/30">
                  {product.tag || product.category}
                </span>
              </div>

              <!-- Quick Trust Pillars -->
              <div class="grid grid-cols-2 gap-3 text-center pt-2">
                <div class="p-3 rounded-xl bg-[#161616] border border-white/5">
                  <i class="fas fa-certificate text-[#42bf80] text-sm mb-1 block"></i>
                  <span class="text-[11px] text-gray-300 font-medium block">100% Authentic</span>
                  <span class="text-[9px] text-gray-500">Siam Sanctuary Guaranteed</span>
                </div>
                <div class="p-3 rounded-xl bg-[#161616] border border-white/5">
                  <i class="fas fa-store text-[#38bdf8] text-sm mb-1 block"></i>
                  <span class="text-[11px] text-gray-300 font-medium block">Salon Pickup</span>
                  <span class="text-[9px] text-gray-500">10 Global Destinations</span>
                </div>
              </div>
            </div>

            <!-- Right: Product Information & Purchase -->
            <div class="lg:col-span-7 space-y-6">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase font-bold tracking-widest bg-[#f286aa]/10 text-[#f286aa] border border-[#f286aa]/30">
                    {product.category}
                  </span>
                  <span class="text-xs text-gray-400 font-light">
                    Part of the At-Home Rituals Collection
                  </span>
                </div>

                <h1 class="text-2xl sm:text-4xl font-serif text-white uppercase tracking-wide leading-tight mb-3">
                  {product.name}
                </h1>

                <div class="flex items-baseline gap-2">
                  <span class="text-3xl font-serif font-bold text-[#f286aa]">
                    {product.price}
                  </span>
                  <span class="text-xs text-gray-500 font-sans uppercase">USD / Tax Included</span>
                </div>
              </div>

              {product.subtitle && (
                <p class="text-sm text-[#d9c1a3] font-serif italic border-l-2 border-[#f286aa] pl-4 py-1">
                  "{product.subtitle}"
                </p>
              )}

              <!-- Main Story & Description -->
              <div class="text-xs sm:text-sm text-gray-300 font-light leading-relaxed space-y-3 whitespace-pre-line border-t border-white/5 pt-4">
                {product.description}
              </div>

              <!-- Key Benefits List -->
              {product.benefits && product.benefits.length > 0 && (
                <div class="space-y-2 border-y border-white/10 py-4">
                  <h4 class="text-xs font-serif text-white uppercase tracking-wider mb-2">Key Ritual Benefits:</h4>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-gray-300">
                    {product.benefits.map((benefit: string) => (
                      <div class="flex items-start gap-2">
                        <i class="fas fa-check-circle text-[#42bf80] text-xs mt-0.5 flex-shrink-0"></i>
                        <span>{benefit}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- How to Use Ritual Step -->
              {product.howToUse && (
                <div class="p-4 rounded-xl bg-[#181818] border border-white/5 space-y-1.5">
                  <div class="flex items-center gap-2 text-[#d9c1a3] text-xs font-serif font-semibold uppercase tracking-wider">
                    <i class="fas fa-hand-sparkles text-[#f286aa]"></i>
                    <span>The Self-Care Ritual (How to Use):</span>
                  </div>
                  <p class="text-xs text-gray-300 font-light leading-relaxed">
                    {product.howToUse}
                  </p>
                </div>
              )}

              <!-- Materials & Composition -->
              {product.materials && (
                <div class="text-xs text-gray-400 font-light flex items-center gap-2">
                  <span class="text-white font-medium">Composition:</span>
                  <span>{product.materials}</span>
                </div>
              )}

              <!-- Purchase CTA Buttons -->
              <div class="flex flex-wrap items-center gap-4 pt-4">
                <a 
                  href={`mailto:info@siamsanctuary.asia?subject=Order%20Inquiry%20-%20${encodeURIComponent(product.name)}&body=Hello%20Dream%20Salon%20Team%2C%0A%0AI%20would%20like%20to%20order%20the%20${encodeURIComponent(product.name)}%20(${product.price}%20USD).%0A%0A-%20Quantity%3A%201%0A-%20Preferred%20Fulfillment%3A%20Salon%20Pickup%20or%20Shipping%0A-%20Preferred%20Salon%20Hub%20or%20Mailing%20Address%3A%20%0A%0APlease%20let%20me%20know%20how%20to%20complete%20payment.%0A%0AThank%20you%21`} 
                  class="btn-luxury-primary text-xs inline-flex items-center gap-2"
                >
                  <i class="fas fa-shopping-bag"></i>
                  <span>Order via Email Concierge</span>
                </a>

                <a 
                  href={`https://wa.me/17878348888?text=Hello%20Dream%20Salon%2C%20I%20would%20like%20to%20inquire%20about%20ordering%20the%20${encodeURIComponent(product.name)}%20(${product.price}).`}
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-xs text-emerald-400 hover:text-white border border-emerald-500/30 hover:border-emerald-500 px-5 py-3 rounded-full transition inline-flex items-center gap-2"
                >
                  <i class="fab fa-whatsapp text-sm"></i>
                  <span>WhatsApp Concierge</span>
                </a>
              </div>

            </div>

          </div>
        </div>

        <!-- Related Products Section -->
        {relatedProducts.length > 0 && (
          <div>
            <div class="flex items-center justify-between mb-8 pb-4 border-b border-white/10">
              <div>
                <span class="text-xs uppercase tracking-widest text-[#f286aa] font-semibold block mb-1">Ritual Pairings</span>
                <h3 class="text-2xl font-serif text-white uppercase tracking-wide">Complementary Self-Care Essentials</h3>
              </div>
              <a href="/shop" class="text-xs text-[#d9c1a3] hover:text-white flex items-center gap-1 font-medium">
                <span>View Full Shop</span>
                <i class="fas fa-arrow-right text-[10px]"></i>
              </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {relatedProducts.map((rel) => (
                <a 
                  href={`/shop/${rel.slug}`}
                  class="group p-5 rounded-2xl bg-[#121212] border border-white/5 hover:border-[#f286aa]/40 transition duration-300 flex flex-col justify-between"
                >
                  <div>
                    <div class="rounded-xl overflow-hidden aspect-square bg-[#101010] mb-4 border border-white/5 flex items-center justify-center p-4">
                      <img 
                        src={rel.image} 
                        alt={rel.name} 
                        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" 
                        loading="lazy"
                      />
                    </div>
                    <span class="text-[10px] uppercase tracking-widest text-[#d9c1a3] font-semibold block mb-1">
                      {rel.category}
                    </span>
                    <h4 class="text-base font-serif text-white group-hover:text-[#f286aa] transition mb-2">
                      {rel.name}
                    </h4>
                  </div>
                  <div class="pt-3 border-t border-white/5 flex items-center justify-between">
                    <span class="text-base font-serif font-bold text-white">{rel.price} USD</span>
                    <span class="text-xs text-[#f286aa] group-hover:translate-x-1 transition-transform">View &rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    </main>

    <Footer />
  </div>
</Layout>
