---
import galleryItems from '../data/gallery.json';

interface Props {
  limit?: number;
  showAllLink?: boolean;
  mode?: 'carousel' | 'grid';
}

const { limit = 0, showAllLink = true, mode = 'carousel' } = Astro.props;
const displayItems = limit > 0 ? galleryItems.slice(0, limit) : galleryItems;
---

{mode === 'carousel' ? (
  <!-- Section 19: Full-Bleed Infinite Photo Swiper matching original Atura theme -->
  <section id="gallery" class="w-full bg-[#141414] overflow-hidden select-none border-t border-white/5 py-0 relative lte-gallery-sc lte-gallery-slider">
    <div class="relative w-full overflow-hidden">
      <div class="gallery-marquee-track whitespace-nowrap" id="gallery-carousel">
        {displayItems.concat(displayItems).map((item, index) => (
          <a 
            href="javascript:void(0)" 
            class="gallery-item lte-gallery-item flex-shrink-0 relative cursor-pointer group"
            data-index={index % displayItems.length}
            data-img={item.image}
            data-title={item.title}
            data-cat-name={item.categoryName}
            data-desc={item.description}
            aria-label={`Inspect ${item.title}`}
          >
            <img 
              src={item.image} 
              alt={item.title} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-115" 
              loading="lazy" 
            />
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <span class="w-12 h-12 rounded-full bg-[#f286aa] text-black flex items-center justify-center text-sm shadow-xl transform scale-75 group-hover:scale-100 transition-transform duration-300">
                <i class="icon icon-search" aria-hidden="true"></i>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
) : (
  <section id="gallery" class="py-24 bg-[#181818] relative select-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-1">
          creative
        </span>
        <h2 class="text-3xl sm:text-5xl font-serif text-white uppercase tracking-wider mb-4">
          Nail Art Portfolio
        </h2>
        <p class="text-sm text-gray-400 font-light max-w-xl mx-auto">
          Browse authentic client nail designs, hand-painted artwork, sculpted acrylics, and mirror chrome sets handcrafted by our certified technicians. Click any photo to inspect in full resolution.
        </p>
      </div>

      <!-- Category Filters -->
      <div class="flex items-center justify-center gap-2 sm:gap-3 flex-wrap mb-12" id="gallery-filters">
        <button class="filter-btn active px-4 py-2 rounded-full text-xs font-medium uppercase tracking-wider transition bg-[#f286aa] text-black cursor-pointer shadow-md" data-filter="all">
          All Designs ({galleryItems.length})
        </button>
        <button class="filter-btn px-4 py-2 rounded-full text-xs font-medium uppercase tracking-wider transition bg-white/5 text-gray-300 hover:text-white hover:bg-white/10 cursor-pointer" data-filter="nail-art">
          Nail Art
        </button>
        <button class="filter-btn px-4 py-2 rounded-full text-xs font-medium uppercase tracking-wider transition bg-white/5 text-gray-300 hover:text-white hover:bg-white/10 cursor-pointer" data-filter="gel">
          Gel Polish
        </button>
        <button class="filter-btn px-4 py-2 rounded-full text-xs font-medium uppercase tracking-wider transition bg-white/5 text-gray-300 hover:text-white hover:bg-white/10 cursor-pointer" data-filter="acrylic">
          Acrylic Sculpt
        </button>
        <button class="filter-btn px-4 py-2 rounded-full text-xs font-medium uppercase tracking-wider transition bg-white/5 text-gray-300 hover:text-white hover:bg-white/10 cursor-pointer" data-filter="chrome">
          Chrome & Glazed
        </button>
        <button class="filter-btn px-4 py-2 rounded-full text-xs font-medium uppercase tracking-wider transition bg-white/5 text-gray-300 hover:text-white hover:bg-white/10 cursor-pointer" data-filter="french">
          French & Ombré
        </button>
        <button class="filter-btn px-4 py-2 rounded-full text-xs font-medium uppercase tracking-wider transition bg-white/5 text-gray-300 hover:text-white hover:bg-white/10 cursor-pointer" data-filter="glam">
          Gems & 3D Charms
        </button>
      </div>

      <!-- Responsive Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6" id="gallery-grid">
        {displayItems.map((item, index) => (
          <div 
            class="gallery-item group relative rounded-2xl overflow-hidden aspect-[3/4] bg-[#111111] border border-white/5 hover:border-[#f286aa]/50 transition-all duration-500 cursor-pointer shadow-xl hover:-translate-y-1.5" 
            data-category={item.category}
            data-index={index}
            data-img={item.image}
            data-title={item.title}
            data-cat-name={item.categoryName}
            data-desc={item.description}
          >
            <img 
              src={item.image} 
              alt={item.title} 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              loading="lazy" 
            />

            <!-- Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4 sm:p-5">
              <span class="text-[10px] uppercase tracking-widest text-[#d9c1a3] font-semibold mb-1">
                {item.categoryName}
              </span>
              <h3 class="text-sm sm:text-base font-serif text-white font-medium line-clamp-1">
                {item.title}
              </h3>
              <div class="mt-2 flex items-center gap-1.5 text-xs text-[#f286aa]">
                <i class="fas fa-search-plus text-[11px]"></i>
                <span>Click to Zoom</span>
              </div>
            </div>

            <!-- Subtle permanent corner badge -->
            <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full text-[9px] uppercase tracking-wider bg-black/60 backdrop-blur-md text-gray-300 font-mono border border-white/10 group-hover:opacity-0 transition-opacity">
              #{index + 1}
            </span>

          </div>
        ))}
      </div>

      {showAllLink && (
        <div class="mt-14 text-center">
          <a href="/gallery" class="btn-luxury-primary text-xs !py-3 !px-8 shadow-xl">
            <i class="fas fa-th-large mr-2"></i>
            <span>View All 79+ Client Creations</span>
          </a>
        </div>
      )}

    </div>
  </section>
)}

  <!-- Interactive Lightbox Modal (WCAG 2.1 AA / Section 508 Compliant) -->
  <div 
    id="lightbox-modal" 
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Nail art design inspection modal"
  >
    <div class="relative w-full max-w-4xl bg-[#161616] border border-[#d9c1a3]/30 rounded-3xl overflow-hidden shadow-2xl flex flex-col md:flex-row max-h-[90vh] focus:outline-none">
      
      <!-- Close Button -->
      <button 
        id="lightbox-close" 
        class="absolute top-3 right-4 z-30 w-10 h-10 rounded-full bg-black/60 hover:bg-[#f286aa] hover:text-black text-white text-xl flex items-center justify-center transition cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa]" 
        aria-label="Close nail art preview modal"
      >
        &times;
      </button>

      <!-- Image Area with Next/Prev Arrows -->
      <div class="relative flex-1 bg-black flex items-center justify-center min-h-[300px] md:min-h-[500px] overflow-hidden">
        <img id="lightbox-img" src="" alt="Full resolution nail art design preview" class="max-h-[75vh] w-auto max-w-full object-contain transition-transform duration-300" />
        
        <button 
          id="lightbox-prev" 
          class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/60 hover:bg-[#f286aa] hover:text-black text-white flex items-center justify-center transition cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa]" 
          aria-label="Previous nail art photo"
        >
          <i class="fas fa-chevron-left text-xs" aria-hidden="true"></i>
        </button>
        <button 
          id="lightbox-next" 
          class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/60 hover:bg-[#f286aa] hover:text-black text-white flex items-center justify-center transition cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa]" 
          aria-label="Next nail art photo"
        >
          <i class="fas fa-chevron-right text-xs" aria-hidden="true"></i>
        </button>
      </div>

      <!-- Details Sidebar -->
      <div class="w-full md:w-80 p-6 md:p-8 flex flex-col justify-between bg-[#191919] border-t md:border-t-0 md:border-l border-white/10">
        <div>
          <span id="lightbox-cat" class="text-xs uppercase tracking-widest text-[#f286aa] font-semibold block mb-2">Category</span>
          <h3 id="lightbox-title" class="text-2xl font-serif text-white uppercase tracking-wide mb-4 leading-tight">Design Title</h3>
          <p id="lightbox-desc" class="text-xs text-gray-300 font-light leading-relaxed mb-6">
            Description of the bespoke nail design.
          </p>
          <div class="text-[11px] text-[#d9c1a3] flex items-center gap-2 border-y border-white/10 py-3">
            <i class="fas fa-shield-virus text-[#f286aa]"></i>
            <span>Hospital-Grade Sterile Tools</span>
          </div>
        </div>

        <div class="pt-6">
          <button class="open-booking-modal w-full btn-luxury-primary text-xs !py-3 cursor-pointer">
            <i class="far fa-calendar-check mr-2"></i>
            <span>Book This Design</span>
          </button>
          <span class="block text-center text-[10px] text-gray-500 mt-2">Bring this photo to your appointment</span>
        </div>
      </div>

    </div>
  </div>

<style>
  .gallery-marquee-track {
    display: flex;
    width: max-content;
    animation: galleryMarquee 950s linear infinite;
    will-change: transform;
  }
  .gallery-marquee-track:hover {
    animation-play-state: paused;
  }
  @keyframes galleryMarquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
  .lte-gallery-item {
    display: block;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    width: 380px;
    height: 506px;
    border-right: 1px solid #000 !important;
    background-color: #141414;
  }
  .lte-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0px;
    transition: transform 0.4s ease;
  }
  .lte-gallery-item:hover img {
    transform: scale(1.15);
  }
  @media (max-width: 767px) {
    .lte-gallery-item {
      width: 290px;
      height: 386px;
    }
  }
</style>

<script is:inline>
  function initGallerySystem() {
    const filterBtns = document.querySelectorAll('#gallery-filters .filter-btn');
    const items = document.querySelectorAll('.gallery-item');
    const modal = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxCat = document.getElementById('lightbox-cat');
    const lightboxDesc = document.getElementById('lightbox-desc');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let visibleItems = Array.from(items);
    let currentIdx = 0;

    // Filter Logic (only active on grid page)
    if (filterBtns.length > 0) {
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('bg-[#f286aa]', 'text-black');
            b.classList.add('bg-white/5', 'text-gray-300');
          });
          btn.classList.add('bg-[#f286aa]', 'text-black');
          btn.classList.remove('bg-white/5', 'text-gray-300');

          const filter = btn.getAttribute('data-filter');
          visibleItems = [];
          items.forEach(item => {
            const cat = item.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              item.style.display = 'block';
              visibleItems.push(item);
            } else {
              item.style.display = 'none';
            }
          });
        });
      });
    }

    // Lightbox Logic
    function openLightbox(index) {
      if (!visibleItems.length) return;
      currentIdx = (index + visibleItems.length) % visibleItems.length;
      const target = visibleItems[currentIdx];
      if (!target) return;

      if (lightboxImg) lightboxImg.src = target.getAttribute('data-img') || '';
      if (lightboxTitle) lightboxTitle.textContent = target.getAttribute('data-title') || '';
      if (lightboxCat) lightboxCat.textContent = target.getAttribute('data-cat-name') || '';
      if (lightboxDesc) lightboxDesc.textContent = target.getAttribute('data-desc') || '';

      if (modal) modal.classList.remove('opacity-0', 'pointer-events-none');
    }

    function closeLightbox() {
      if (modal) modal.classList.add('opacity-0', 'pointer-events-none');
    }

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const idx = visibleItems.indexOf(item);
        if (idx !== -1) openLightbox(idx);
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', () => openLightbox(currentIdx - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => openLightbox(currentIdx + 1));

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeLightbox();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (modal && !modal.classList.contains('opacity-0')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') openLightbox(currentIdx - 1);
        if (e.key === 'ArrowRight') openLightbox(currentIdx + 1);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallerySystem);
  } else {
    initGallerySystem();
  }
</script>
