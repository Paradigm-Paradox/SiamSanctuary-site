---
const promoCards = [
  {
    subtitle: "creative",
    title: "Nail Salon",
    description: "“Express your style at your fingertips! Nail art, where creativity meets elegance in every stroke. Elevate your nails, embrace beauty.”",
    icon: "fa-paint-brush",
    linkText: "Explore Designs",
    linkHref: "/gallery"
  },
  {
    subtitle: "professional",
    title: "Nail Care",
    description: "“Nail the art of self-expression! Elevate your fingertips with hospital-grade sanitization, sterile single-use supplies, and certified artistry.”",
    icon: "fa-gem",
    linkText: "Our Standards",
    linkHref: "/about-us"
  },
  {
    subtitle: "quality",
    title: "Services",
    description: "“Nail your style with captivating artistry. From chic minimalism to bold statements, our master technicians transform fingertips into masterpieces.”",
    icon: "fa-hand-sparkles",
    linkText: "View Price Menu",
    linkHref: "#services-menu"
  }
];
---

<section class="py-12 sm:py-16 bg-[#111111] relative border-b border-white/5 z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {promoCards.map((card, index) => (
        <div class="relative group p-8 rounded-2xl bg-[#181818] border border-white/5 hover:border-[#d9c1a3]/30 transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/60 flex flex-col justify-between">
          <!-- Subtle decorative card number / watermark -->
          <div class="absolute top-4 right-6 text-4xl font-serif text-white/[0.04] font-bold select-none group-hover:text-[#f286aa]/10 transition-colors">
            0{index + 1}
          </div>

          <div>
            <!-- Icon & Subtitle Header -->
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-xl bg-[#222222] border border-white/10 flex items-center justify-center text-[#f286aa] group-hover:border-[#f286aa]/40 group-hover:bg-[#f286aa]/10 transition-colors">
                <i class={`fas ${card.icon} text-lg`}></i>
              </div>
              <div>
                <span class="font-script text-2xl text-[#f286aa] block leading-tight">
                  {card.subtitle}
                </span>
                <h3 class="text-xl sm:text-2xl font-serif text-white uppercase tracking-wider group-hover:text-[#d9c1a3] transition-colors">
                  {card.title}
                </h3>
              </div>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-gray-300 font-light leading-relaxed mb-6 italic">
              {card.description}
            </p>
          </div>

          <!-- Action Link -->
          <div class="pt-4 border-t border-white/5 flex items-center justify-between">
            <a href={card.linkHref} class="text-xs font-semibold uppercase tracking-widest text-[#d9c1a3] hover:text-[#f286aa] transition flex items-center gap-2">
              <span>{card.linkText}</span>
              <i class="fas fa-arrow-right text-[10px] transform group-hover:translate-x-1 transition-transform"></i>
            </a>
            <span class="w-2 h-2 rounded-full bg-[#f286aa]/40 group-hover:bg-[#f286aa] transition-colors"></span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
