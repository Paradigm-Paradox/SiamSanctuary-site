---

<section id="locations" class="py-24 bg-[#141414] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-1">
        our salons
      </span>
      <h2 class="text-3xl sm:text-5xl font-serif text-white uppercase tracking-wider mb-4">
        Global Salons & Hubs
      </h2>
      <p class="text-sm text-gray-400 font-light max-w-xl mx-auto">
        DreamNails brings personalized luxury nail care across the Americas, Southeast Asia, the Middle East, and Africa.
      </p>
    </div>

    <!-- 6 Global Locations Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {locations.map((loc) => (
        <div class="rounded-2xl bg-[#1c1c1c] border border-white/5 hover:border-[#d9c1a3]/40 p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl group flex flex-col justify-between">
          
          <div>
            <!-- Header with airport code & badge -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold px-2.5 py-1 rounded bg-[#f286aa]/10 text-[#f286aa] border border-[#f286aa]/20">
                {loc.code}
              </span>
              <span class="text-[10px] uppercase tracking-widest text-[#d9c1a3] font-semibold">
                {loc.badge}
              </span>
            </div>

            <h3 class="text-2xl font-serif text-white group-hover:text-[#f286aa] transition mb-1">
              {loc.city}
            </h3>
            <span class="text-xs font-sans text-gray-400 block mb-3">{loc.country}</span>
            <p class="text-xs text-[#d9c1a3] font-serif italic mb-5">{loc.tagline}</p>

            <div class="space-y-2 text-xs text-gray-300 border-t border-white/5 pt-4">
              <div class="flex items-start gap-2.5">
                <i class="fas fa-map-marker-alt text-[#f286aa] text-xs mt-0.5" aria-hidden="true"></i>
                <span>{loc.address}</span>
              </div>
              <div class="flex items-center gap-2.5">
                <i class="far fa-clock text-gray-400 text-xs" aria-hidden="true"></i>
                <span class="text-gray-400">{loc.hours}</span>
              </div>
              <div class="flex items-center gap-2.5">
                <i class="far fa-envelope text-[#d9c1a3] text-xs" aria-hidden="true"></i>
                <a href={`mailto:${loc.email}`} class="text-gray-300 hover:text-white transition focus-visible:ring-1 focus-visible:ring-[#d9c1a3] rounded p-0.5">{loc.email}</a>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between">
            <a href={`mailto:${loc.email}?subject=Booking%20Inquiry%20-%20${loc.city}`} class="text-xs uppercase tracking-wider text-[#f286aa] hover:text-white transition font-medium flex items-center gap-1.5 focus-visible:ring-1 focus-visible:ring-[#f286aa] rounded p-0.5">
              <span>Book in {loc.city}</span>
              <i class="fas fa-arrow-right text-[10px]" aria-hidden="true"></i>
            </a>
            <span class="text-[10px] text-gray-500 uppercase tracking-widest">Walk-ins / Appt</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
