---
---

<section id="philosophy" class="py-24 bg-[#181818] relative overflow-hidden">
  <!-- Subtle decorative watermark -->
  <div class="absolute -right-20 top-1/2 -translate-y-1/2 opacity-5 select-none pointer-events-none">
    <span class="font-script text-[18rem] text-[#f286aa] leading-none">Dream</span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Visual Collage -->
      <div class="relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="relative z-10 rounded-2xl overflow-hidden border border-[#d9c1a3]/20 shadow-2xl">
            <img 
              src="/uploads/2022/01/about-2.png" 
              alt="Dream Nails Studio Care & Craft" 
              class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
            />
          </div>

          <!-- Floating Accent Card -->
          <div class="absolute -bottom-8 -right-4 sm:-right-8 z-20 bg-[#121212] p-5 sm:p-6 rounded-2xl border border-[#f286aa]/30 shadow-2xl max-w-xs">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-[#f286aa]/10 flex items-center justify-center text-[#f286aa] text-xl font-bold font-serif">
                54
              </div>
              <div>
                <div class="text-xs font-semibold text-white uppercase tracking-wider">Professional Techniques</div>
                <div class="text-[11px] text-gray-400 mt-0.5">Mastered by our certified international artists</div>
              </div>
            </div>
          </div>

          <!-- Secondary Image Badge -->
          <div class="absolute -top-8 -left-4 sm:-left-8 z-20 hidden sm:block w-32 h-32 rounded-2xl overflow-hidden border border-white/10 shadow-xl">
            <img 
              src="/uploads/2022/05/VeryGoodNail01.png" 
              alt="Nail Art Precision" 
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>

      <!-- Content Column -->
      <div class="space-y-6">
        <div>
          <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-1">
            Empowerment & Sanctuary
          </span>
          <h2 class="text-3xl sm:text-5xl font-serif text-white uppercase tracking-wide leading-tight">
            Modern Style <br />
            <span class="text-[#d9c1a3]">& High Quality Work</span>
          </h2>
        </div>

        <p class="text-gray-300 text-sm sm:text-base leading-relaxed font-light">
          At <strong class="text-white font-medium">Dream Nails – Asia</strong>, founded by Joey & Onanong Jones, we believe beauty is more than just an experience—it’s an empowering movement. Rooted in the tropical beauty of Phuket, Thailand, our mission is to create a welcoming, esthetic, and cozy sanctuary where confidence, self-care, and sophistication come to life.
        </p>

        <p class="text-gray-400 text-sm leading-relaxed">
          Cleanliness is a detailed focus in our salons. We adhere to rigorous hospital-grade disinfection procedures. All metal tools are cleaned, disinfected, dried, and vacuum-sealed individually for each client, remaining in our sterilizer machines until used. Every buffer, file, and pumice stone is 100% single-use and disposable.
        </p>

        <!-- Highlights Checklist -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <div class="flex items-center gap-2.5 text-xs text-gray-300">
            <i class="fas fa-check-circle text-[#f286aa]"></i>
            <span>Hospital-Grade Sterilization</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs text-gray-300">
            <i class="fas fa-check-circle text-[#f286aa]"></i>
            <span>Single-Use Liners & Pumices</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs text-gray-300">
            <i class="fas fa-check-circle text-[#f286aa]"></i>
            <span>15+ Years International Craft</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs text-gray-300">
            <i class="fas fa-check-circle text-[#f286aa]"></i>
            <span>Custom Hand-Painted Designs</span>
          </div>
        </div>

        <div class="pt-4 flex items-center gap-4">
          <a href="/about-us" class="btn-luxury-outline text-xs">
            <span>Read Our Full Story</span>
            <i class="fas fa-arrow-right ml-1"></i>
          </a>
          <button class="open-booking-modal btn-luxury-primary text-xs cursor-pointer">
            <span>Schedule A Visit</span>
          </button>
        </div>

      </div>

    </div>
  </div>
</section>
