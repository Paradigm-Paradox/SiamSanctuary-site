---
const subServices = [
  {
    title: "MANICURE",
    desc: "A manicure is a mostly cosmetic beauty treatment for the fingernails and hands",
    icon: "fa-hand-sparkles"
  },
  {
    title: "PEDICURE",
    desc: "A pedicure is a cosmetic treatment of the feet and toenails, analogous to a manicure.",
    icon: "fa-spa"
  },
  {
    title: "NAIL CARE",
    desc: "The care and maintenance of the fingernails and toenails.",
    icon: "fa-magic"
  },
  {
    title: "COSMETICS",
    desc: "The most popular cosmetics are hair dyes, powders and creams.",
    icon: "fa-pump-soap"
  }
];
---

<section id="philosophy" class="py-20 sm:py-28 bg-[#141414] relative overflow-hidden select-none">
  <!-- Subtle decorative watermark from original Atura theme -->
  <div class="absolute -right-20 top-16 opacity-5 select-none pointer-events-none animate-float-slow">
    <span class="font-script text-[14rem] sm:text-[18rem] text-[#f286aa] leading-none">nail styles</span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-16">
      
      <!-- Left: Visual Collage matching about-2.png exactly as in original site (No box border) -->
      <div class="relative reveal-scale flex items-center justify-center">
        <img 
          src="/images/2022/01/about-2.png" 
          alt="Luxury nail salon craftsmanship and manicure artistry at Dream Nails Asia" 
          class="w-full max-w-lg h-auto object-contain transform hover:scale-105 transition-transform duration-700 drop-shadow-2xl"
        />
      </div>

      <!-- Right: Content Column matching original WordPress site typography and layout -->
      <div class="space-y-6 reveal-on-scroll">
        <div>
          <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-1">
            nail styles
          </span>
          <h2 class="text-3xl sm:text-5xl font-serif text-white uppercase tracking-wider leading-tight">
            MODERN STYLE <br />
            AND HIGH QUALITY WORK
          </h2>
        </div>

        <p class="text-gray-300 text-sm sm:text-base leading-relaxed font-light">
          Above all, we place the highest emphasis in cleanliness, and all the technicians are trained to adhere to the strictest sanitation standards. Let your worries behind and treat yourself at Uptown Nail Spa.
        </p>

        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed font-light">
          DreamNails.Asia services include nail enhancements, pedicures, manicures, and other services that are all performed to the highest standards. The difference is that our services are provided with the utmost care and professionalism.
        </p>

        <!-- Inline Live Metrics matching original theme (Not floating cards) -->
        <div class="pt-4 flex items-center gap-12 sm:gap-16">
          <!-- Metric 1: 54 Professional Techniques -->
          <div class="flex items-center gap-4">
            <span class="text-5xl sm:text-6xl font-serif font-bold text-[#f286aa] counter-number" data-target="54">
              0
            </span>
            <div class="text-xs text-white uppercase tracking-wider leading-snug font-medium">
              Professional <br />Techniques
            </div>
          </div>

          <!-- Metric 2: 314 Nail polish colors -->
          <div class="flex items-center gap-4">
            <span class="text-5xl sm:text-6xl font-serif font-bold text-[#f286aa] counter-number" data-target="314">
              0
            </span>
            <div class="text-xs text-white uppercase tracking-wider leading-snug font-medium">
              Nail polish <br />colors
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- 4 Circular Sub-Service Badges matching original Atura theme layout -->
    <div class="pt-16 border-t border-white/5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      {subServices.map((serv, i) => (
        <div class={`flex flex-col items-center group cursor-pointer reveal-on-scroll ${i === 1 ? 'reveal-delay-100' : i === 2 ? 'reveal-delay-200' : i === 3 ? 'reveal-delay-300' : ''}`}>
          
          <!-- Circular Outline Badge -->
          <div class="w-24 h-24 rounded-full border border-white/15 group-hover:border-[#f286aa] flex items-center justify-center text-[#f286aa] mb-5 bg-[#181818]/60 group-hover:bg-[#f286aa]/10 transition-all duration-300 transform group-hover:scale-110 shadow-lg">
            <i class={`fas ${serv.icon} text-2xl`} aria-hidden="true"></i>
          </div>

          <!-- Sub-Service Heading -->
          <h4 class="text-sm font-serif text-white uppercase tracking-widest mb-2 group-hover:text-[#f286aa] transition-colors">
            {serv.title}
          </h4>

          <!-- Description -->
          <p class="text-xs text-gray-400 font-light leading-relaxed max-w-xs">
            {serv.desc}
          </p>

        </div>
      ))}
    </div>

  </div>

  <script is:inline>
    // Live Number CountUp Animation
    function setupPhilosophyCounters() {
      const counters = document.querySelectorAll('#philosophy .counter-number');
      if (!counters.length) return;

      const animateCount = (el) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const duration = 1800; // ms
        const startTime = performance.now();

        function step(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = Math.floor(eased * target);
          el.textContent = current.toString();

          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            el.textContent = target.toString();
          }
        }

        requestAnimationFrame(step);
      };

      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              animateCount(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.3 });

        counters.forEach(c => obs.observe(c));
      } else {
        counters.forEach(animateCount);
      }
    }

    document.addEventListener('DOMContentLoaded', setupPhilosophyCounters);
  </script>
</section>
