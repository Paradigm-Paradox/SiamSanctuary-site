---
---

<section id="philosophy" class="py-24 bg-[#181818] relative overflow-hidden">
  <!-- Subtle decorative watermark from original Atura theme with subtle parallax float -->
  <div class="absolute -right-16 top-12 opacity-5 select-none pointer-events-none animate-float-slow">
    <span class="font-script text-[14rem] sm:text-[18rem] text-[#f286aa] leading-none">nail bar</span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-16">
      
      <!-- Visual Collage matching about-2.png with Reveal & Float -->
      <div class="relative reveal-scale">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="relative z-10 rounded-2xl overflow-hidden border border-[#d9c1a3]/20 shadow-2xl bg-[#0f0f0f] group">
            <img 
              src="/images/2022/01/about-2.png" 
              alt="Luxury nail salon craftsmanship and manicure artistry at Dream Nails Asia" 
              class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700"
            />
          </div>

          <!-- Floating Counter Card 1: 54 Professional Techniques -->
          <div class="absolute -bottom-6 -left-4 sm:-left-8 z-20 bg-[#121212] p-5 rounded-2xl border border-[#f286aa]/30 shadow-2xl max-w-[240px] transform hover:-translate-y-1 transition-transform">
            <div class="flex items-center gap-4">
              <div class="text-3xl sm:text-4xl font-serif font-bold text-[#f286aa] counter-number" data-target="54">
                0
              </div>
              <div class="text-xs font-semibold text-white uppercase tracking-wider leading-snug">
                Professional <br />Techniques
              </div>
            </div>
          </div>

          <!-- Floating Counter Card 2: 314 Nail Polish Colors -->
          <div class="absolute -top-6 -right-4 sm:-right-8 z-20 bg-[#121212] p-5 rounded-2xl border border-[#d9c1a3]/30 shadow-2xl max-w-[240px] transform hover:-translate-y-1 transition-transform">
            <div class="flex items-center gap-4">
              <div class="text-3xl sm:text-4xl font-serif font-bold text-[#d9c1a3] counter-number" data-target="314">
                0
              </div>
              <div class="text-xs font-semibold text-white uppercase tracking-wider leading-snug">
                Nail Polish <br />Colors
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Content Column matching original text -->
      <div class="space-y-6 reveal-on-scroll">
        <div>
          <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-1">
            nail styles
          </span>
          <h2 class="text-3xl sm:text-5xl font-serif text-white uppercase tracking-wide leading-tight">
            Modern Style <br />
            <span class="text-[#d9c1a3]">& High Quality Work</span>
          </h2>
        </div>

        <p class="text-gray-200 text-sm sm:text-base leading-relaxed font-light">
          Above all, we place the highest emphasis in cleanliness, and all the technicians are trained to sterilize all the equipment so that each customer can have a very pleasant experience.
        </p>

        <p class="text-gray-400 text-sm leading-relaxed">
          DreamNails.Asia services include nail enhancements, pedicures, manicures, and other services. Our licensed and trained nail technicians are dedicated to personal attention and complete customer satisfaction in all our branches.
        </p>

        <!-- Highlights Checklist -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <div class="flex items-center gap-2.5 text-xs text-gray-300">
            <i class="fas fa-check-circle text-[#f286aa]" aria-hidden="true"></i>
            <span>Hospital-Grade Sterilization</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs text-gray-300">
            <i class="fas fa-check-circle text-[#f286aa]" aria-hidden="true"></i>
            <span>Single-Use Liners & Buffers</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs text-gray-300">
            <i class="fas fa-check-circle text-[#f286aa]" aria-hidden="true"></i>
            <span>Licensed International Technicians</span>
          </div>
          <div class="flex items-center gap-2.5 text-xs text-gray-300">
            <i class="fas fa-check-circle text-[#f286aa]" aria-hidden="true"></i>
            <span>Custom Hand-Crafted Nail Art</span>
          </div>
        </div>

        <div class="pt-4 flex items-center gap-4">
          <a href="/about-us" class="btn-luxury-outline text-xs focus-visible:ring-1 focus-visible:ring-[#d9c1a3]">
            <span>Read Our Full Story</span>
            <i class="fas fa-arrow-right ml-1" aria-hidden="true"></i>
          </a>
          <button class="open-booking-modal btn-luxury-primary text-xs cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa]">
            <span>Book An Appointment</span>
          </button>
        </div>

      </div>

    </div>

    <!-- 4 Sub-Service Cards from Original Theme (MANICURE, PEDICURE, NAIL CARE, COSMETICS) -->
    <div class="pt-12 border-t border-white/5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="p-6 rounded-2xl bg-[#141414] border border-white/5 hover:border-[#f286aa]/40 transition-all duration-300 group hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-black/70 reveal-on-scroll">
        <div class="w-12 h-12 rounded-xl bg-[#222222] flex items-center justify-center text-[#f286aa] mb-4 group-hover:scale-110 group-hover:bg-[#f286aa]/10 transition-all">
          <i class="fas fa-hand-sparkles text-lg" aria-hidden="true"></i>
        </div>
        <h4 class="text-base font-serif text-white uppercase tracking-wider mb-2 group-hover:text-[#f286aa] transition-colors">
          Manicure
        </h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">
          A manicure is a mostly cosmetic beauty treatment for the fingernails and hands, leaving them immaculate and refreshed.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-[#141414] border border-white/5 hover:border-[#d9c1a3]/40 transition-all duration-300 group hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-black/70 reveal-on-scroll reveal-delay-100">
        <div class="w-12 h-12 rounded-xl bg-[#222222] flex items-center justify-center text-[#d9c1a3] mb-4 group-hover:scale-110 group-hover:bg-[#d9c1a3]/10 transition-all">
          <i class="fas fa-spa text-lg" aria-hidden="true"></i>
        </div>
        <h4 class="text-base font-serif text-white uppercase tracking-wider mb-2 group-hover:text-[#d9c1a3] transition-colors">
          Pedicure
        </h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">
          A pedicure is a cosmetic treatment of the feet and toenails, analogous to a manicure, providing deep relaxation and care.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-[#141414] border border-white/5 hover:border-[#f286aa]/40 transition-all duration-300 group hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-black/70 reveal-on-scroll reveal-delay-200">
        <div class="w-12 h-12 rounded-xl bg-[#222222] flex items-center justify-center text-[#f286aa] mb-4 group-hover:scale-110 group-hover:bg-[#f286aa]/10 transition-all">
          <i class="fas fa-magic text-lg" aria-hidden="true"></i>
        </div>
        <h4 class="text-base font-serif text-white uppercase tracking-wider mb-2 group-hover:text-[#f286aa] transition-colors">
          Nail Care
        </h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">
          The care and maintenance of the fingernails and toenails, fortifying structural health and longevity.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-[#141414] border border-white/5 hover:border-[#d9c1a3]/40 transition-all duration-300 group hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-black/70 reveal-on-scroll reveal-delay-300">
        <div class="w-12 h-12 rounded-xl bg-[#222222] flex items-center justify-center text-[#d9c1a3] mb-4 group-hover:scale-110 group-hover:bg-[#d9c1a3]/10 transition-all">
          <i class="fas fa-pump-soap text-lg" aria-hidden="true"></i>
        </div>
        <h4 class="text-base font-serif text-white uppercase tracking-wider mb-2 group-hover:text-[#d9c1a3] transition-colors">
          Cosmetics
        </h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">
          The most popular cosmetics are gentle organic formulas, nourishing powders, and protective luxury cuticle creams.
        </p>
      </div>

    </div>

  </div>

  <script is:inline>
    // Live Number CountUp Animation
    function setupCounters() {
      const counters = document.querySelectorAll('.counter-number');
      if (!counters.length) return;

      const animateCount = (el) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const duration = 1800; // ms
        const startTime = performance.now();

        function step(now) {
          const progress = Math.min((now - startTime) / duration, 1);
          // Ease-out cubic
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = Math.floor(eased * target);
          el.textContent = current.toString();

          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            el.textContent = target.toString();
          }
        }

        requestAnimationFrame(step);
      };

      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              animateCount(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.3 });

        counters.forEach(c => obs.observe(c));
      } else {
        counters.forEach(animateCount);
      }
    }

    document.addEventListener('DOMContentLoaded', setupCounters);
  </script>
</section>
