---
const subServices = [
  {
    title: "HAIR & HEAD SPA",
    desc: "Bespoke styling, balayage color, Japanese scalp rituals, and keratin smoothing.",
    icon: "icon-serv_04"
  },
  {
    title: "COUTURE NAILS",
    desc: "Hospital-grade manicures, medical pedicures, and certified gel artistry.",
    icon: "icon-serv_01"
  },
  {
    title: "LASH, BROW & PMU",
    desc: "Volume lash extensions, brow shaping, and soft natural cosmetic tattooing.",
    icon: "icon-serv_03"
  },
  {
    title: "MASSAGE & FACIALS",
    desc: "Organic skin rejuvenation, Thai aroma body therapy, and relaxing head-to-toe care.",
    icon: "icon-serv_02"
  }
];
---

<section id="philosophy" class="py-20 sm:py-28 bg-[#141414] relative overflow-hidden select-none">
  <!-- Subtle decorative watermark from original Atura theme -->
  <div class="absolute -right-20 top-16 opacity-5 select-none pointer-events-none animate-float-slow">
    <span class="font-script text-[14rem] sm:text-[18rem] text-[#f286aa] leading-none">salon sanctuary</span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-16">
      
      <!-- Left: Visual Collage matching about-2.png exactly as in original site (No box border) -->
      <div class="relative reveal-scale flex items-center justify-center">
        <img 
          src="/images/2022/01/about-2.png" 
          alt="Luxury salon craftsmanship and beauty artistry at Dream Salon Asia" 
          class="w-full max-w-lg h-auto object-contain transform hover:scale-105 transition-transform duration-700 drop-shadow-2xl"
        />
      </div>

      <!-- Right: Content Column matching original WordPress site typography and layout -->
      <div class="space-y-6 reveal-on-scroll">
        <div>
          <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-1">
            salon artistry
          </span>
          <h2 class="text-3xl sm:text-5xl font-serif text-white uppercase tracking-wider leading-tight">
            MODERN STYLE <br />
            AND HIGH QUALITY WORK
          </h2>
        </div>

        <p class="text-gray-300 text-sm sm:text-base leading-relaxed font-light">
          Above all, we place the highest emphasis on cleanliness, and all our stylists, aestheticians, and artists are trained to adhere to hospital-grade sanitation standards. Leave your worries behind and immerse yourself in absolute tranquility at Dream Salon & Spa.
        </p>

        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed font-light">
          Dream Salon Asia encompasses complete salon and spa rituals: bespoke haircuts and color, Japanese scalp head spa, couture nail enhancements, lash & brow PMU, holistic facials, and Thai aroma therapy, all provided with personalized VIP care.
        </p>

        <!-- Inline Live Metrics matching original theme (Not floating cards) -->
        <div class="pt-4 flex items-center gap-12 sm:gap-16">
          <!-- Metric 1: 54 Professional Techniques -->
          <div class="flex items-center gap-4">
            <span class="text-6xl sm:text-7xl font-serif font-normal text-[#f286aa] counter-number" data-target="54">
              54
            </span>
            <div class="text-xs text-white uppercase tracking-wider leading-snug font-medium">
              Professional <br />Techniques
            </div>
          </div>

          <!-- Metric 2: 300+ Bespoke Colors & Treatments -->
          <div class="flex items-center gap-4">
            <span class="text-6xl sm:text-7xl font-serif font-normal text-[#f286aa] counter-number" data-target="300">
              300+
            </span>
            <div class="text-xs text-white uppercase tracking-wider leading-snug font-medium">
              Bespoke Colors <br />& Treatments
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- 4 Circular Sub-Service Badges matching original Atura theme layout -->
    <div class="pt-16 border-t border-white/5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      {subServices.map((serv, i) => (
        <div class={`flex flex-col items-center group cursor-pointer reveal-on-scroll ${i === 1 ? 'reveal-delay-100' : i === 2 ? 'reveal-delay-200' : i === 3 ? 'reveal-delay-300' : ''}`}>
          
          <!-- Circular Outline / Organic Backdrop Badge from original lte-icons -->
          <div class="w-44 h-44 sm:w-48 sm:h-48 rounded-full bg-[#1c1c1c] group-hover:bg-[#222222] border border-white/10 group-hover:border-[#f286aa]/40 transition-all duration-500 flex items-center justify-center relative mb-6 shadow-2xl group-hover:scale-105">
            <i class={`icon ${serv.icon} text-6xl sm:text-7xl text-[#f286aa] transition-transform duration-500 group-hover:scale-110`} aria-hidden="true"></i>
          </div>

          <!-- Sub-Service Heading -->
          <h3 class="text-base sm:text-lg font-serif text-white uppercase tracking-[0.15em] mb-2 group-hover:text-[#f286aa] transition-colors">
            {serv.title}
          </h3>

          <!-- Description -->
          <p class="text-xs text-gray-400 font-light leading-relaxed max-w-[220px] mx-auto">
            {serv.desc}
          </p>

        </div>
      ))}
    </div>

  </div>
</section>
