---
---

<section class="relative py-28 sm:py-36 bg-[#0a0a0a] overflow-hidden flex items-center justify-center text-center">
  <!-- Parallax Background Image with Dark Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/2022/01/video-bg-2.jpg" 
      alt="" 
      aria-hidden="true"
      class="w-full h-full object-cover object-center filter brightness-[0.42] contrast-125 scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-black/40 to-[#141414]"></div>
  </div>

  <!-- Content Container with Scroll Reveal -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 space-y-6 reveal-on-scroll">
    <!-- Subtitle in Quentin Cursive Font -->
    <span class="font-script text-3xl sm:text-5xl text-[#f286aa] block leading-tight drop-shadow-md" aria-hidden="true">
      salon experience
    </span>

    <!-- Heading in Cormorant Infant -->
    <h2 class="text-3xl sm:text-6xl font-serif text-white uppercase tracking-widest font-normal drop-shadow-lg">
      Watch Our Video
    </h2>

    <p class="text-sm sm:text-base text-gray-200 font-light max-w-xl mx-auto drop-shadow leading-relaxed">
      Take a behind-the-scenes glimpse into our tranquil sanctuaries, hospital-grade sterilization protocols, and masterful nail artistry.
    </p>

    <!-- Animated Luxury Play Button with Concentric Rings -->
    <div class="pt-6">
      <button 
        id="open-video-btn"
        class="inline-flex items-center justify-center w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-[#f286aa] text-black text-2xl sm:text-3xl relative group shadow-2xl shadow-[#f286aa]/50 hover:scale-110 transition-transform duration-300 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#f286aa] cursor-pointer"
        aria-label="Play Dream Nails Showcase Video in popup dialog"
      >
        <!-- Concentric pulsing rings -->
        <span class="absolute -inset-3 rounded-full border border-[#f286aa]/40 animate-concentric-pulse" aria-hidden="true"></span>
        <span class="absolute -inset-1 rounded-full border border-[#d9c1a3]/50 group-hover:border-[#d9c1a3] transition-colors" aria-hidden="true"></span>
        
        <i class="fas fa-play ml-1.5 text-black" aria-hidden="true"></i>
      </button>
      <div class="text-[11px] uppercase tracking-[0.25em] text-[#d9c1a3] font-sans mt-5 font-medium">
        Watch Our Global Salon Reel
      </div>
    </div>
  </div>

  <!-- Interactive Video Cinema Modal (WCAG 2.1 AA Compliant) -->
  <div 
    id="video-modal" 
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/95 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Dream Nails Salon Experience Video Reel"
  >
    <div class="relative w-full max-w-4xl bg-[#141414] border border-[#d9c1a3]/30 rounded-2xl overflow-hidden shadow-2xl transform scale-95 transition-transform duration-300 focus:outline-none">
      <button 
        id="close-video-btn" 
        class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-black/70 hover:bg-[#f286aa] text-white hover:text-black flex items-center justify-center transition cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa]"
        aria-label="Close video player"
      >&times;</button>

      <div class="relative aspect-video w-full bg-black">
        <iframe 
          id="video-iframe" 
          class="w-full h-full"
          src="" 
          title="Dream Nails Asia Salon Tour and Artistry Reel"
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen
        ></iframe>
      </div>

      <div class="p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-3 bg-[#181818] border-t border-white/5">
        <div class="text-left">
          <h4 class="text-sm font-serif text-white uppercase tracking-wider">Dream Nails Asia Official Showcase</h4>
          <p class="text-xs text-gray-400">Hospital-Grade Sterilization • Phuket • Mayagüez • Bali • Dubai</p>
        </div>
        <a 
          href="https://www.youtube.com/@DreamNailsAsia" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-luxury-primary text-xs !py-2 !px-4"
        >
          <i class="fab fa-youtube mr-1.5" aria-hidden="true"></i>
          <span>Subscribe on YouTube</span>
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    function setupVideoModal() {
      const openBtn = document.getElementById('open-video-btn');
      const closeBtn = document.getElementById('close-video-btn');
      const modal = document.getElementById('video-modal');
      const iframe = document.getElementById('video-iframe');
      const defaultVideoUrl = "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ?autoplay=1"; // Fallback demo embed

      if (!openBtn || !modal || !iframe) return;

      function openModal() {
        iframe.src = defaultVideoUrl;
        modal.classList.remove('opacity-0', 'pointer-events-none');
        const card = modal.querySelector('div');
        if (card) card.classList.remove('scale-95');
        if (closeBtn) closeBtn.focus();
      }

      function closeModal() {
        modal.classList.add('opacity-0', 'pointer-events-none');
        const card = modal.querySelector('div');
        if (card) card.classList.add('scale-95');
        // Stop playback
        iframe.src = "";
        openBtn.focus();
      }

      openBtn.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
          closeModal();
        }
      });
    }

    document.addEventListener('DOMContentLoaded', setupVideoModal);
  </script>
</section>
