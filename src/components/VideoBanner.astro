---
---

<section class="relative py-28 sm:py-36 bg-[#0a0a0a] overflow-hidden flex items-center justify-center text-center">
  <!-- Parallax Background Image with Dark Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/uploads/2022/01/video-bg-2.jpg" 
      alt="Dream Nails Studio Video" 
      class="w-full h-full object-cover object-center filter brightness-[0.45] contrast-125 scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-black/40 to-[#141414]"></div>
  </div>

  <!-- Content Container -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 space-y-6">
    <!-- Subtitle in Quentin Cursive Font -->
    <span class="font-script text-3xl sm:text-5xl text-[#f286aa] block leading-tight drop-shadow-md">
      salon experience
    </span>

    <!-- Heading in Cormorant Infant -->
    <h2 class="text-3xl sm:text-6xl font-serif text-white uppercase tracking-widest font-normal drop-shadow-lg">
      Watch Our Video
    </h2>

    <p class="text-sm sm:text-base text-gray-200 font-light max-w-xl mx-auto drop-shadow leading-relaxed">
      Take a behind-the-scenes glimpse into our tranquil sanctuaries, hospital-grade sterilization protocols, and masterful nail artistry.
    </p>

    <!-- Animated Luxury Play Button -->
    <div class="pt-6">
      <a 
        href="https://www.youtube.com/@DreamNails-Asia" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center justify-center w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-[#f286aa] text-black text-2xl sm:text-3xl relative group shadow-2xl shadow-[#f286aa]/40 hover:scale-110 transition-transform duration-300"
        aria-label="Play Dream Nails Showcase Video on YouTube"
      >
        <!-- Pulsing concentric wave rings -->
        <span class="absolute inset-0 rounded-full bg-[#f286aa] animate-ping opacity-25"></span>
        <span class="absolute -inset-2 rounded-full border border-[#d9c1a3]/40 group-hover:border-[#d9c1a3] transition-colors"></span>
        
        <i class="fas fa-play ml-1 text-black"></i>
      </a>
      <div class="text-[11px] uppercase tracking-[0.25em] text-[#d9c1a3] font-sans mt-4 font-medium">
        Watch on Official YouTube Channel
      </div>
    </div>
  </div>
</section>
