---
import services from '../data/services.json';
import socials from '../data/socials.json';
import SocialIcon from './SocialIcon.astro';

interface Props {
  overlay?: boolean;
}

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const { overlay = isHome } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about-us' },
  { name: 'Services', href: '/services' },
  { name: 'News', href: '/news' },
  { name: 'Shop', href: '/shop' },
  { name: 'Testimonials', href: '/#testimonials' },
  { name: 'Contacts', href: '/contacts' },
];
---

<header class={`w-full ${overlay ? 'absolute top-0 left-0 right-0 z-40' : 'relative z-40'} select-none`} id="site-header">
  <!-- Slim Top Black Utility Bar with Official Social Logo Pack -->
  <div class="bg-[#0a0a0a]/90 backdrop-blur-sm text-gray-300 py-1.5 px-4 sm:px-8 border-b border-white/10 text-xs">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <!-- Quick Social Icons with Official Brand Logos -->
      <div class="hidden sm:flex items-center gap-2 text-[12px]">
        <span class="text-[10px] uppercase tracking-wider text-gray-400 font-medium hidden md:inline">Connect:</span>
        <div class="flex items-center gap-1.5">
          {socials.map((s) => (
            <a 
              href={s.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-5 h-5 rounded-md overflow-hidden hover:scale-125 transition-transform shadow-sm block focus-visible:ring-1 focus-visible:ring-[#f286aa]" 
              title={`${s.name} (${s.handle})`}
              aria-label={`Visit Dream Nails on ${s.name}`}
            >
              <SocialIcon id={s.id} class="w-full h-full" />
            </a>
          ))}
        </div>
      </div>

      <!-- Right Utility Actions -->
      <div class="flex items-center gap-5 ml-auto sm:ml-0">
        <a href="/gallery" class="flex items-center gap-1.5 hover:text-[#f286aa] transition text-[11px] uppercase tracking-wider">
          <i class="icon icon-search text-[11px]" aria-hidden="true"></i>
          <span>search</span>
        </a>
        <a href="/shop" class="flex items-center gap-1.5 hover:text-[#f286aa] transition text-[11px] uppercase tracking-wider">
          <i class="icon icon-login text-[11px]" aria-hidden="true"></i>
          <span>login</span>
        </a>
        <a href="/shop" class="flex items-center gap-1.5 hover:text-[#f286aa] transition text-[11px] uppercase tracking-wider">
          <i class="icon icon-shopping-bag text-[11px]" aria-hidden="true"></i>
          <span>cart</span>
          <span class="bg-[#f286aa] text-black text-[9px] font-bold rounded-full w-4 h-4 inline-flex items-center justify-center ml-0.5">0</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main White Navbar matching original Atura theme with overlay styling -->
  <nav id="main-navbar" class="bg-white/95 backdrop-blur-md text-[#181818] shadow-md px-4 sm:px-8 py-2 sm:py-2.5 transition-all duration-300" aria-label="Main Navigation">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Brand Logo (Larger 1:1 Scale matching original) -->
      <a href="/" class="flex items-center group focus-visible:ring-2 focus-visible:ring-[#f286aa] rounded-lg p-1" aria-label="Dream Nails Asia Homepage">
        <img 
          src="/images/2022/04/Dream-Salon-Transparent-BG-01-noborder-1.png" 
          alt="DreamNails.Asia" 
          class="h-16 sm:h-20 md:h-[92px] lg:h-[98px] w-auto max-w-[240px] sm:max-w-[300px] md:max-w-[360px] object-contain transition-transform duration-300 group-hover:scale-105"
        />
      </a>

      <!-- Desktop Nav Menu (Dark Text on White) -->
      <div class="hidden lg:flex items-center gap-6 xl:gap-8">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          
          if (link.name === 'Services') {
            return (
              <div class="relative group py-2">
                <a 
                  href="/services" 
                  class={`inline-flex items-center gap-1.5 text-[14px] font-sans font-medium tracking-wide transition-colors py-1 relative focus-visible:ring-1 focus-visible:ring-[#f286aa] ${
                    isActive 
                      ? 'text-[#f286aa] font-semibold' 
                      : 'text-[#222222] hover:text-[#f286aa]'
                  }`}
                >
                  <span>Services</span>
                  <i class="fas fa-chevron-down text-[10px] transition-transform duration-200 group-hover:rotate-180"></i>
                </a>

                {/* Dropdown Flyout */}
                <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-[640px] opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div 
                    class="bg-[#141414] border border-[#f286aa]/30 rounded-2xl shadow-[0_25px_60px_-15px_rgba(0,0,0,0.95)] p-5 text-white"
                    style="background-color: #141414 !important; opacity: 1 !important;"
                  >
                    {/* Dropdown Header */}
                    <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/10">
                      <div>
                        <span class="text-[10px] uppercase tracking-widest text-[#f286aa] font-bold">Luxury Sanctuary Offerings</span>
                        <h4 class="text-sm font-serif text-white tracking-wide">Signature Salon Services</h4>
                      </div>
                      <a href="/services" class="text-xs text-[#d9c1a3] hover:text-[#f286aa] transition flex items-center gap-1.5 font-medium group/link">
                        <span>All Services Overview</span>
                        <i class="fas fa-arrow-right text-[10px] group-hover/link:translate-x-0.5 transition-transform"></i>
                      </a>
                    </div>

                    {/* 2-Column Grid of 13 Services */}
                    <div class="grid grid-cols-2 gap-2 max-h-[440px] overflow-y-auto pr-1">
                      {services.map((svc) => (
                        <a
                          href={`/services/${svc.slug}`}
                          class="flex items-center gap-3 p-2.5 rounded-xl bg-[#1c1c1c] hover:bg-[#252525] border border-white/5 hover:border-[#f286aa]/40 transition group/item"
                          style="background-color: #1c1c1c;"
                        >
                          <div class="w-8 h-8 rounded-lg bg-[#2a2a2a] text-[#f286aa] flex items-center justify-center text-xs flex-shrink-0 group-hover/item:bg-[#f286aa] group-hover/item:text-black transition-colors">
                            <i class={`fas ${svc.icon}`}></i>
                          </div>
                          <div class="min-w-0 flex-1">
                            <div class="text-xs font-semibold text-white group-hover/item:text-[#f286aa] truncate transition-colors flex items-center gap-1.5">
                              <span>{svc.title}</span>
                              {svc.slug === 'cosmetic-tattoo-pmu' || svc.slug === 'hair-treatments-head-spa' || svc.slug === 'packages-vip' ? (
                                <span class="text-[9px] bg-[#f286aa] text-black px-1.5 py-0.2 rounded font-sans uppercase font-bold">New</span>
                              ) : null}
                            </div>
                            <div class="text-[11px] text-gray-400 truncate font-light">
                              {svc.tag}
                            </div>
                          </div>
                        </a>
                      ))}
                    </div>

                    {/* Dropdown Footer CTA */}
                    <div class="mt-3 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] text-gray-400">
                      <span class="flex items-center gap-1.5">
                        <i class="fas fa-certificate text-[#f286aa]"></i>
                        <span>Hospital-Grade Autoclave Sterilization</span>
                      </span>
                      <button class="open-booking-modal text-[#f286aa] hover:text-white uppercase tracking-wider font-semibold cursor-pointer transition flex items-center gap-1">
                        <span>Book Appointment</span>
                        <span class="text-xs">&rarr;</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a 
              href={link.href} 
              class={`text-[14px] font-sans font-medium tracking-wide transition-colors py-1 relative focus-visible:ring-1 focus-visible:ring-[#f286aa] ${
                isActive 
                  ? 'text-[#f286aa] font-semibold' 
                  : 'text-[#222222] hover:text-[#f286aa]'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </div>

      <!-- Action Buttons matching original header (Phone + Black Book Now Button) -->
      <div class="hidden md:flex items-center gap-6">
        <a href="tel:+17878348888" class="text-xs text-[#222222] hover:text-[#f286aa] transition flex items-center gap-2 focus-visible:ring-1 focus-visible:ring-[#f286aa] rounded p-1 tracking-wider font-medium">
          <i class="icon icon-phone text-[#f286aa] text-sm" aria-hidden="true"></i>
          <span>+1 787 XXX XXXX</span>
        </a>
        <button class="open-booking-modal bg-[#141414] hover:bg-[#f286aa] text-white hover:text-black font-sans text-xs uppercase tracking-wider font-semibold py-3 px-6 rounded-none transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-sm focus-visible:ring-2 focus-visible:ring-[#141414]">
          <span>Book now</span>
          <span class="text-xs">&rarr;</span>
        </button>
      </div>

      <!-- Mobile Menu Toggle -->
      <button 
        id="mobile-menu-btn" 
        class="lg:hidden p-2 text-[#222222] hover:text-[#f286aa] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f286aa] rounded"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <i class="fas fa-bars text-xl" id="menu-icon" aria-hidden="true"></i>
      </button>

    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="hidden lg:hidden pt-4 pb-6 border-t border-gray-100 mt-3 space-y-2 bg-white max-h-[80vh] overflow-y-auto">
      {navLinks.map((link) => {
        if (link.name === 'Services') {
          return (
            <div class="space-y-1">
              <div class="flex items-center justify-between py-2 px-3 text-sm tracking-wide text-gray-800 hover:bg-gray-50 rounded-lg">
                <a href="/services" class="font-medium text-gray-900 hover:text-[#f286aa] flex-1">
                  Services
                </a>
                <button 
                  id="mobile-services-toggle"
                  type="button"
                  class="p-1.5 text-gray-500 hover:text-[#f286aa] focus:outline-none"
                  aria-label="Toggle services submenu"
                >
                  <i class="fas fa-chevron-down text-xs transition-transform duration-200" id="services-chevron"></i>
                </button>
              </div>
              <div id="mobile-services-sublist" class="hidden pl-4 pr-2 space-y-1 border-l-2 border-[#f286aa]/30 ml-4 py-1">
                <a 
                  href="/services" 
                  class="block py-1.5 px-2 text-xs font-semibold text-[#f286aa] hover:bg-pink-50 rounded"
                >
                  &rarr; All Services Overview
                </a>
                {services.map((svc) => (
                  <a 
                    href={`/services/${svc.slug}`} 
                    class="block py-1.5 px-2 text-xs text-gray-700 hover:text-[#f286aa] hover:bg-gray-50 rounded flex items-center justify-between"
                  >
                    <span>{svc.title}</span>
                    <i class={`fas ${svc.icon} text-[10px] text-gray-400`}></i>
                  </a>
                ))}
              </div>
            </div>
          );
        }
        return (
          <a 
            href={link.href} 
            class="block py-2 px-3 text-sm tracking-wide text-gray-800 hover:text-[#f286aa] hover:bg-gray-50 rounded-lg transition"
          >
            {link.name}
          </a>
        );
      })}
      <div class="pt-3 border-t border-gray-100 flex flex-col gap-2.5">
        <a href="tel:+17878348888" class="text-center py-2.5 rounded-md border border-gray-200 text-gray-800 text-xs tracking-wider flex items-center justify-center gap-2">
          <i class="fas fa-phone-alt text-[#f286aa] text-xs" aria-hidden="true"></i>
          <span>+1 787 XXX XXXX</span>
        </a>
        <button class="open-booking-modal w-full text-center py-2.5 rounded-md bg-[#141414] text-white font-semibold text-xs uppercase tracking-wider cursor-pointer">
          Book now &rarr;
        </button>

        <!-- Mobile Social Links Grid with Official Logos -->
        <div class="pt-2 text-center">
          <span class="text-[10px] uppercase tracking-wider text-gray-400 block mb-2 font-medium">Follow & Chat Across 12 Channels:</span>
          <div class="flex items-center justify-center flex-wrap gap-2.5">
            {socials.map((s) => (
              <a 
                href={s.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="w-7 h-7 rounded-lg overflow-hidden shadow-sm hover:scale-115 transition-transform block" 
                title={`${s.name} (${s.handle})`}
                aria-label={`Visit Dream Nails on ${s.name}`}
              >
                <SocialIcon id={s.id} class="w-full h-full" />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      if (mobileMenu.classList.contains('hidden')) {
        menuIcon.classList.remove('fa-times');
        menuIcon.classList.add('fa-bars');
      } else {
        menuIcon.classList.remove('fa-bars');
        menuIcon.classList.add('fa-times');
      }
    });
  }

  const servicesToggle = document.getElementById('mobile-services-toggle');
  const servicesSublist = document.getElementById('mobile-services-sublist');
  const servicesChevron = document.getElementById('services-chevron');
  if (servicesToggle && servicesSublist) {
    servicesToggle.addEventListener('click', (e) => {
      e.preventDefault();
      servicesSublist.classList.toggle('hidden');
      if (servicesChevron) {
        servicesChevron.classList.toggle('rotate-180');
      }
    });
  }
</script>
