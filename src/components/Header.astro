---
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about-us' },
  { name: 'Services', href: '/services' },
  { name: 'Gallery', href: '/gallery' },
  { name: 'News', href: '/news' },
  { name: 'Shop', href: '/shop' },
  { name: 'Testimonials', href: '/#testimonials' },
  { name: 'Contacts', href: '/contacts' },
];
---

<header class="w-full relative z-40">
  <!-- Top Utility Bar matching original Atura theme -->
  <div class="bg-[#0b0b0b] border-b border-white/5 py-2 px-4 sm:px-8 text-xs text-gray-400">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2">
      
      <!-- Left: Global Hubs & Hours -->
      <div class="flex items-center gap-4 flex-wrap justify-center text-[11px] sm:text-xs">
        <span class="inline-flex items-center gap-1.5 text-gray-300">
          <i class="fas fa-gem text-[#f286aa]" aria-hidden="true"></i>
          <span>Global Hubs: Mayagüez • Phuket • Pattaya • Bali • Dubai • Douala</span>
        </span>
        <span class="hidden xl:inline text-gray-600" aria-hidden="true">•</span>
        <span class="hidden xl:inline-flex items-center gap-1.5 text-gray-400">
          <i class="far fa-clock text-[#d9c1a3]" aria-hidden="true"></i>
          <span>Mon-Fri & Sun: 9:00 AM – 5:00 PM</span>
        </span>
      </div>

      <!-- Right: Search, Account, Cart & Socials from original theme -->
      <div class="flex items-center gap-4 text-xs">
        <div class="flex items-center gap-3 text-gray-300">
          <!-- Live Search Link -->
          <a href="/gallery" class="hover:text-[#f286aa] transition flex items-center gap-1 focus-visible:ring-1 focus-visible:ring-[#f286aa] rounded p-1" title="Search designs & services">
            <i class="fas fa-search text-xs" aria-hidden="true"></i>
            <span class="hidden sm:inline text-[11px] uppercase tracking-wider font-medium">Search</span>
          </a>
          <span class="text-gray-700" aria-hidden="true">|</span>
          <!-- Shop Account Link -->
          <a href="/shop" class="hover:text-[#f286aa] transition flex items-center gap-1 focus-visible:ring-1 focus-visible:ring-[#f286aa] rounded p-1" title="Customer portal & products">
            <i class="far fa-user text-xs" aria-hidden="true"></i>
            <span class="hidden sm:inline text-[11px] uppercase tracking-wider font-medium">Login</span>
          </a>
          <span class="text-gray-700" aria-hidden="true">|</span>
          <!-- Cart Badge -->
          <a href="/shop" class="hover:text-[#d9c1a3] transition flex items-center gap-1.5 focus-visible:ring-1 focus-visible:ring-[#d9c1a3] rounded p-1" title="View shopping bag">
            <i class="fas fa-shopping-bag text-xs text-[#d9c1a3]" aria-hidden="true"></i>
            <span class="text-[11px] uppercase tracking-wider font-medium">Cart</span>
            <span class="w-4 h-4 rounded-full bg-[#f286aa] text-black text-[9px] font-bold flex items-center justify-center">0</span>
          </a>
        </div>

        <div class="flex items-center gap-2.5 text-gray-400 pl-3 border-l border-white/10">
          <a href="https://fb.com/DreamNails.Asia" target="_blank" rel="noopener noreferrer" class="hover:text-[#f286aa] transition p-1 focus-visible:ring-1 focus-visible:ring-[#f286aa] rounded" aria-label="Visit Dream Nails on Facebook" title="Facebook"><i class="fab fa-facebook-f text-xs" aria-hidden="true"></i></a>
          <a href="https://www.youtube.com/@DreamNailsAsia" target="_blank" rel="noopener noreferrer" class="hover:text-[#f286aa] transition p-1 focus-visible:ring-1 focus-visible:ring-[#f286aa] rounded" aria-label="Visit Dream Nails on YouTube" title="YouTube"><i class="fab fa-youtube text-xs" aria-hidden="true"></i></a>
          <a href="mailto:info@dreamnails.asia" class="hover:text-[#f286aa] transition p-1 focus-visible:ring-1 focus-visible:ring-[#f286aa] rounded" aria-label="Send email to Dream Nails" title="Email"><i class="far fa-envelope text-xs" aria-hidden="true"></i></a>
        </div>
      </div>

    </div>
  </div>

  <!-- Primary Floating Luxury Header -->
  <nav class="bg-[#141414]/90 backdrop-blur-md border-b border-[#d9c1a3]/10 sticky top-0 px-4 sm:px-8 py-3.5 transition-all" aria-label="Main Navigation">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus-visible:ring-2 focus-visible:ring-[#f286aa] rounded-lg p-1" aria-label="Dream Nails Asia Homepage">
        <img 
          src="/images/2022/04/Dream-Salon-Transparent-BG-02-noborder-1.png" 
          alt="Dream Nails Asia Luxury Nail Sanctuary Logo" 
          class="h-12 sm:h-14 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        />
        <div class="hidden sm:block">
          <span class="block text-xl sm:text-2xl font-serif tracking-widest text-white uppercase group-hover:text-[#f286aa] transition">Dream Nails</span>
          <span class="block text-[10px] tracking-[0.25em] text-[#d9c1a3] uppercase font-sans">Perfection in Every Brush</span>
        </div>
      </a>

      <!-- Desktop Nav Menu -->
      <div class="hidden lg:flex items-center gap-6 xl:gap-7">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a 
              href={link.href} 
              class={`text-xs uppercase tracking-[0.14em] font-medium transition-colors duration-200 py-1 relative focus-visible:ring-1 focus-visible:ring-[#f286aa] rounded ${
                isActive 
                  ? 'text-[#f286aa] after:content-[""] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-[#f286aa]' 
                  : 'text-gray-300 hover:text-[#f286aa]'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </div>

      <!-- Action Buttons matching original header (Phone + Book Now) -->
      <div class="hidden md:flex items-center gap-4">
        <a href="tel:+17878348888" class="text-xs font-serif font-bold text-gray-300 hover:text-[#d9c1a3] transition flex items-center gap-2 focus-visible:ring-1 focus-visible:ring-[#d9c1a3] rounded p-1 tracking-wider">
          <i class="fas fa-phone-alt text-[#f286aa] text-xs" aria-hidden="true"></i>
          <span>+1 787 834 8888</span>
        </a>
        <button class="open-booking-modal btn-luxury-primary text-xs !py-2.5 !px-5 shadow-lg shadow-[#f286aa]/20 cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa]">
          <span>Book now</span>
          <i class="fas fa-arrow-right text-[10px] ml-1" aria-hidden="true"></i>
        </button>
      </div>

      <!-- Mobile Menu Toggle -->
      <button 
        id="mobile-menu-btn" 
        class="lg:hidden p-2 text-gray-300 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f286aa] rounded"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <i class="fas fa-bars text-xl" id="menu-icon" aria-hidden="true"></i>
      </button>

    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="hidden lg:hidden pt-4 pb-6 border-t border-white/5 mt-3 space-y-3">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="block py-2 px-3 text-sm uppercase tracking-wider text-gray-300 hover:text-[#f286aa] hover:bg-white/5 rounded-lg transition"
        >
          {link.name}
        </a>
      ))}
      <div class="pt-3 border-t border-white/10 flex flex-col gap-2.5">
        <a href="tel:+17878348888" class="text-center py-2.5 rounded-full border border-white/10 text-gray-300 text-xs tracking-wider flex items-center justify-center gap-2">
          <i class="fas fa-phone-alt text-[#f286aa] text-xs" aria-hidden="true"></i>
          <span>+1 787 834 8888</span>
        </a>
        <a href="/shop" class="text-center py-2.5 rounded-full border border-[#d9c1a3] text-[#d9c1a3] text-xs uppercase tracking-wider">
          Visit Organic Shop
        </a>
        <button class="open-booking-modal w-full text-center py-2.5 rounded-full bg-[#f286aa] text-black font-semibold text-xs uppercase tracking-wider cursor-pointer">
          Book Appointment
        </button>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      if (mobileMenu.classList.contains('hidden')) {
        menuIcon.classList.remove('fa-times');
        menuIcon.classList.add('fa-bars');
      } else {
        menuIcon.classList.remove('fa-bars');
        menuIcon.classList.add('fa-times');
      }
    });
  }
</script>
