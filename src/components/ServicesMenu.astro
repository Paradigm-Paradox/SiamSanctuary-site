---

<section id="services-menu" class="py-24 bg-[#141414] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="font-script text-3xl sm:text-4xl text-[#f286aa] block mb-1">
        our prices
      </span>
      <h2 class="text-3xl sm:text-5xl font-serif text-white uppercase tracking-wider mb-4">
        Popular Services
      </h2>
      <p class="text-sm text-gray-400 font-light max-w-xl mx-auto">
        Our certified stylists, aestheticians, and nail masters deliver bespoke salon care and sensory luxury tailored to your individual style.
      </p>
    </div>

    <!-- 2-Column Responsive Service Price Menu Grid (Playbook de-floated layout) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {services.map((item, idx) => (
        <div class={`flex items-start gap-4 sm:gap-5 p-4 sm:p-5 rounded-2xl bg-[#1b1b1b] border border-white/5 hover:border-[#d9c1a3]/40 transition-all duration-300 group hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-black/60 reveal-on-scroll ${idx % 2 === 1 ? 'reveal-delay-100' : ''}`}>
          
          <!-- Thumbnail -->
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden flex-shrink-0 border border-white/10 group-hover:border-[#f286aa]/40 transition">
            <img 
              src={item.image} 
              alt={item.alt || item.title} 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <!-- Content & Price Header -->
          <div class="flex-1 min-w-0">
            <div class="flex items-baseline justify-between gap-2 border-b border-white/10 pb-2 mb-2">
              <h3 class="text-lg sm:text-xl font-serif text-white group-hover:text-[#f286aa] transition truncate">
                {item.title}
              </h3>
              <div class="text-right flex-shrink-0">
                <span class="text-base sm:text-lg font-serif font-bold text-[#d9c1a3]">
                  {item.price}
                </span>
                <span class="block text-[10px] text-gray-500 uppercase tracking-widest font-sans">
                  {item.approxUsd}
                </span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-gray-400 font-light leading-relaxed line-clamp-3">
              {item.description}
            </p>
          </div>

        </div>
      ))}
    </div>

    <!-- Booking CTA Bar -->
    <div class="mt-16 p-8 rounded-2xl bg-gradient-to-r from-[#1c1c1c] via-[#241c22] to-[#1c1c1c] border border-[#f286aa]/20 text-center max-w-4xl mx-auto shadow-2xl">
      <h3 class="text-2xl font-serif text-white mb-2">Looking for a custom experience or VIP group booking?</h3>
      <p class="text-xs text-gray-300 font-light max-w-lg mx-auto mb-6">
        We specialize in bridal parties, synchronized salon power hours, editorial glam, and complete beauty transformations. Connect with our salon concierge today.
      </p>
      <div class="flex items-center justify-center gap-4 flex-wrap">
        <button class="open-booking-modal btn-luxury-primary text-xs cursor-pointer">
          <i class="far fa-calendar-check mr-1.5"></i>
          <span>Book an Appointment</span>
        </button>
        <a href="/services" class="btn-luxury-outline text-xs">
          <span>View All 13 Service Disciplines</span>
        </a>
      </div>
    </div>

  </div>
</section>
