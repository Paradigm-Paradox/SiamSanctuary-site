---
const slides = [
  {
    image: "/images/2022/02/SLIDE_01-1.jpg",
    scriptTitle: "Perfection in Every Brush",
    heading: "Art Manicure",
    subheading: "Creative color styles. Always in trend. Best quality.",
    cta: "Book Appointment"
  },
  {
    image: "/images/2022/02/SLIDE_02-1.jpg",
    scriptTitle: "Empowering Beauty",
    heading: "Creative Manicure",
    subheading: "Where creativity meets elegance in every stroke. Elevate your nails, embrace beauty.",
    cta: "Explore Service Menu"
  },
  {
    image: "/images/2022/02/SLIDE_03-1.jpg",
    scriptTitle: "Sanctuary of Wellness",
    heading: "Relaxing Paraffin Spa",
    subheading: "Hospital-grade sterile care, herbal botanical soaks, and deep restorative nourishment.",
    cta: "Book Spa Treatment"
  },
  {
    image: "/images/2022/02/SLIDE_04-2.jpg",
    scriptTitle: "Trendsetting Artistry",
    heading: "Soothing Pedicure",
    subheading: "Revitalize tired feet with gentle exfoliation, massage, and chip-free lustrous finishes.",
    cta: "View Nail Gallery"
  }
];
---

<section id="hero-slider" class="relative h-[88vh] sm:h-[92vh] min-h-[640px] max-h-[1050px] w-full overflow-hidden bg-[#0d0d0d] select-none">
  
  <!-- Slides Container -->
  <div class="relative w-full h-full" id="zoom-slider-container">
    {slides.map((slide, idx) => (
      <div 
        class={`zoom-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100 z-10 active' : 'opacity-0 z-0 pointer-events-none'}`} 
        data-slide-index={idx}
      >
        <!-- Background Image with Ken Burns Zoom Effect -->
        <div class="absolute inset-0 overflow-hidden">
          <img 
            src={slide.image} 
            alt={slide.heading} 
            class="slide-bg-img w-full h-full object-cover object-center filter brightness-[0.78] contrast-[1.05]"
            loading={idx === 0 ? "eager" : "lazy"}
          />
          <!-- Luxury Vignette & Dark Overlays -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#141414]/50 to-black/40"></div>
          <div class="absolute inset-0 bg-radial-gradient from-transparent via-black/40 to-black/80"></div>
        </div>

        <!-- Slide Foreground Content -->
        <div class="relative z-20 h-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col justify-center items-center text-center">
          
          <!-- Quentin Calligraphy Accent -->
          <span class="slide-script font-script text-4xl sm:text-5xl md:text-6xl text-[#f286aa] drop-shadow-lg mb-2 block transform translate-y-6 opacity-0 transition-all duration-700 delay-200">
            {slide.scriptTitle}
          </span>

          <!-- Main Heading -->
          <h1 class="slide-title text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-serif font-bold text-white uppercase tracking-wider leading-[1.05] mb-5 transform translate-y-8 opacity-0 transition-all duration-700 delay-300">
            {slide.heading}
          </h1>

          <!-- Description -->
          <p class="slide-desc max-w-2xl text-sm sm:text-base md:text-lg text-gray-200 font-light leading-relaxed mb-8 transform translate-y-8 opacity-0 transition-all duration-700 delay-400">
            {slide.subheading}
          </p>

          <!-- Action Buttons -->
          <div class="slide-actions flex flex-col sm:flex-row items-center gap-4 transform translate-y-8 opacity-0 transition-all duration-700 delay-500">
            <button class="open-booking-modal btn-luxury-primary text-xs sm:text-sm cursor-pointer shadow-2xl shadow-[#f286aa]/30 focus-visible:ring-2 focus-visible:ring-[#f286aa]">
              <i class="far fa-calendar-check mr-2" aria-hidden="true"></i>
              <span>{slide.cta}</span>
            </button>
            <a href="/gallery" class="btn-luxury-outline text-xs sm:text-sm focus-visible:ring-2 focus-visible:ring-[#d9c1a3]">
              <i class="fas fa-images mr-2 text-[#f286aa]" aria-hidden="true"></i>
              <span>Browse 79+ Nail Designs</span>
            </a>
          </div>

        </div>

      </div>
    ))}
  </div>

  <!-- Slider Controls & Indicator Bar -->
  <div class="absolute bottom-10 left-0 right-0 z-30 max-w-6xl mx-auto px-4 sm:px-8 flex items-center justify-between pointer-events-none">
    
    <!-- Slide Counter (e.g. 01 / 04) -->
    <div class="text-xs font-mono tracking-widest text-[#d9c1a3] flex items-center gap-2 pointer-events-auto bg-black/50 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/10" aria-label="Slide counter">
      <span id="slide-current-num" class="text-white font-bold">01</span>
      <span class="text-gray-500">/</span>
      <span class="text-gray-400">04</span>
    </div>

    <!-- Bullet Dots -->
    <div class="flex items-center gap-2.5 pointer-events-auto" id="slider-bullets" role="tablist" aria-label="Slide indicators">
      {slides.map((_, i) => (
        <button 
          class={`bullet-dot h-2 rounded-full transition-all duration-300 cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa] ${i === 0 ? 'w-8 bg-[#f286aa]' : 'w-2 bg-white/30 hover:bg-white/60'}`}
          data-index={i}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={`Go to slide ${i + 1}`}
        ></button>
      ))}
    </div>

    <!-- Arrow Navigation -->
    <div class="flex items-center gap-2 pointer-events-auto">
      <button id="slider-prev" class="w-10 h-10 rounded-full bg-black/50 hover:bg-[#f286aa] hover:text-black text-white border border-white/10 flex items-center justify-center transition-all cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa]" aria-label="Previous slide">
        <i class="fas fa-chevron-left text-xs" aria-hidden="true"></i>
      </button>
      <button id="slider-next" class="w-10 h-10 rounded-full bg-black/50 hover:bg-[#f286aa] hover:text-black text-white border border-white/10 flex items-center justify-center transition-all cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa]" aria-label="Next slide">
        <i class="fas fa-chevron-right text-xs" aria-hidden="true"></i>
      </button>
    </div>

  </div>

  <!-- Trust Badges Bar floating on bottom edge -->
  <div class="hidden lg:block absolute bottom-0 left-0 right-0 z-20 bg-black/75 backdrop-blur-md border-t border-white/10 py-2.5 px-6" aria-label="Salon highlights">
    <div class="max-w-6xl mx-auto flex items-center justify-between text-xs text-gray-300">
      <span class="flex items-center gap-2"><i class="fas fa-shield-virus text-[#f286aa]" aria-hidden="true"></i> 100% Hospital-Grade Disinfection</span>
      <span class="text-gray-600" aria-hidden="true">•</span>
      <span class="flex items-center gap-2"><i class="fas fa-trash text-[#d9c1a3]" aria-hidden="true"></i> Single-Use Disposable Buffers & Liners</span>
      <span class="text-gray-600" aria-hidden="true">•</span>
      <span class="flex items-center gap-2"><i class="fas fa-gem text-[#f286aa]" aria-hidden="true"></i> 15+ Years Master Artistry (Phuket Roots)</span>
      <span class="text-gray-600" aria-hidden="true">•</span>
      <span class="flex items-center gap-2"><i class="fas fa-globe text-[#d9c1a3]" aria-hidden="true"></i> 6 Global Salon Hubs Worldwide</span>
    </div>
  </div>

</section>

<!-- Ken Burns ZoomSlider Animation Styles -->
<style>
  .zoom-slide.active .slide-bg-img {
    animation: kenBurnsZoom 7.5s ease-out forwards;
  }

  .zoom-slide.active .slide-script,
  .zoom-slide.active .slide-title,
  .zoom-slide.active .slide-desc,
  .zoom-slide.active .slide-actions {
    transform: translateY(0);
    opacity: 1;
  }

  @keyframes kenBurnsZoom {
    0% {
      transform: scale(1.02);
    }
    100% {
      transform: scale(1.16);
    }
  }
</style>

<!-- High-Performance Vanilla JS Zoom Slider Engine -->
<script is:inline>
  function initHeroZoomSlider() {
    const slides = document.querySelectorAll('#zoom-slider-container .zoom-slide');
    const bullets = document.querySelectorAll('#slider-bullets .bullet-dot');
    const currentNum = document.getElementById('slide-current-num');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');

    if (!slides.length) return;

    let currentIndex = 0;
    let timer = null;
    const intervalTime = 6500;

    function showSlide(index) {
      if (index === currentIndex) return;
      
      // wrap around
      if (index >= slides.length) index = 0;
      if (index < 0) index = slides.length - 1;

      // Reset old slide
      slides[currentIndex].classList.remove('opacity-100', 'z-10', 'active');
      slides[currentIndex].classList.add('opacity-0', 'z-0', 'pointer-events-none');
      bullets[currentIndex].classList.remove('w-8', 'bg-[#f286aa]');
      bullets[currentIndex].classList.add('w-2', 'bg-white/30');

      // Set new slide
      currentIndex = index;
      slides[currentIndex].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
      slides[currentIndex].classList.add('opacity-100', 'z-10', 'active');
      bullets[currentIndex].classList.remove('w-2', 'bg-white/30');
      bullets[currentIndex].classList.add('w-8', 'bg-[#f286aa]');

      if (currentNum) {
        currentNum.textContent = String(currentIndex + 1).padStart(2, '0');
      }
    }

    function startAutoSlide() {
      stopAutoSlide();
      timer = setInterval(() => {
        showSlide(currentIndex + 1);
      }, intervalTime);
    }

    function stopAutoSlide() {
      if (timer) clearInterval(timer);
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        showSlide(currentIndex + 1);
        startAutoSlide();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        showSlide(currentIndex - 1);
        startAutoSlide();
      });
    }

    bullets.forEach(b => {
      b.addEventListener('click', () => {
        const idx = parseInt(b.getAttribute('data-index') || '0', 10);
        showSlide(idx);
        startAutoSlide();
      });
    });

    const heroSection = document.getElementById('hero-slider');
    if (heroSection) {
      heroSection.addEventListener('mouseenter', stopAutoSlide);
      heroSection.addEventListener('mouseleave', startAutoSlide);
    }

    startAutoSlide();
  }

  document.addEventListener('DOMContentLoaded', initHeroZoomSlider);
</script>
