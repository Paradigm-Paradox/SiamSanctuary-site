---
const slides = [
  {
    image: "/images/2022/02/SLIDE_01-1.jpg",
    scriptTitle: "nail fashion",
    heading: "Art Manicure",
    subheading: "Creative color styles. Always in trend. Best quality.",
    cta: "Read more"
  },
  {
    image: "/images/2022/02/SLIDE_02-1.jpg",
    scriptTitle: "nail fashion",
    heading: "Art Manicure",
    subheading: "Where creativity meets elegance in every stroke. Elevate your nails, embrace beauty.",
    cta: "Read more"
  },
  {
    image: "/images/2022/02/SLIDE_03-1.jpg",
    scriptTitle: "nail fashion",
    heading: "Art Manicure",
    subheading: "Hospital-grade sterile care, herbal botanical soaks, and deep restorative nourishment.",
    cta: "Read more"
  },
  {
    image: "/images/2022/02/SLIDE_04-2.jpg",
    scriptTitle: "nail fashion",
    heading: "Art Manicure",
    subheading: "Revitalize tired feet with gentle exfoliation, massage, and chip-free lustrous finishes.",
    cta: "Read more"
  }
];

const socialLinks = [
  { name: 'facebook', href: 'https://fb.com/DreamNails.Asia' },
  { name: 'twitter', href: 'https://twitter.com' },
  { name: 'instagram', href: 'https://instagram.com' },
  { name: 'youtube', href: 'https://youtube.com/@DreamNailsAsia' },
  { name: 'pinterest', href: 'https://pinterest.com' }
];
---

<section id="hero-slider" class="relative h-[85vh] sm:h-[90vh] min-h-[600px] max-h-[1000px] w-full overflow-hidden bg-[#0d0d0d] select-none">
  
  <!-- Left Side: Vertical Rotated Social Links matching original Atura theme -->
  <div class="hidden xl:flex absolute left-6 top-1/2 -translate-y-1/2 z-30 flex-col items-center gap-8 text-[11px] uppercase tracking-[0.25em] text-white/40 pointer-events-auto">
    {socialLinks.map((s) => (
      <a 
        href={s.href} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="transform -rotate-90 hover:text-[#f286aa] transition-colors py-2"
        aria-label={`Visit Dream Nails on ${s.name}`}
      >
        {s.name}
      </a>
    ))}
  </div>

  <!-- Right Side: Vertical Slide Indicators matching original theme -->
  <div class="hidden sm:flex absolute right-8 top-1/2 -translate-y-1/2 z-30 flex-col items-center gap-3 pointer-events-auto" id="vertical-dots" role="tablist" aria-label="Slide indicators">
    {slides.map((_, i) => (
      <button 
        class={`vertical-dot w-2 h-2 rounded-full transition-all duration-300 cursor-pointer focus-visible:ring-2 focus-visible:ring-[#f286aa] ${i === 0 ? 'bg-[#f286aa] ring-2 ring-[#f286aa]/40' : 'bg-white/40 hover:bg-white'}`}
        data-index={i}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        aria-label={`Go to slide ${i + 1}`}
      ></button>
    ))}
  </div>

  <!-- Slides Container with Ken Burns Zoom Effect -->
  <div class="relative w-full h-full" id="zoom-slider-container">
    {slides.map((slide, idx) => (
      <div 
        class={`zoom-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100 z-10 active' : 'opacity-0 z-0 pointer-events-none'}`} 
        data-slide-index={idx}
      >
        <!-- Background Image with Ken Burns Zoom -->
        <div class="absolute inset-0 overflow-hidden">
          <img 
            src={slide.image} 
            alt={slide.heading} 
            class="slide-bg-img w-full h-full object-cover object-center filter brightness-[0.70] contrast-[1.10]"
            loading={idx === 0 ? "eager" : "lazy"}
          />
          <!-- Luxury Dark Vignette Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#141414]/40 to-black/30"></div>
          <div class="absolute inset-0 bg-radial-gradient from-transparent via-black/30 to-black/70"></div>
        </div>

        <!-- Slide Foreground Content -->
        <div class="relative z-20 h-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col justify-center items-center text-center">
          
          <!-- Giant Background Ghost/Outline Text from original Elementor layout -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none z-0">
            <span class="text-6xl sm:text-8xl md:text-9xl lg:text-[11rem] font-serif font-bold uppercase tracking-wider text-transparent stroke-text opacity-25">
              {slide.heading}
            </span>
          </div>

          <div class="relative z-10 flex flex-col items-center">
            <!-- Quentin Calligraphy Accent -->
            <span class="slide-script font-script text-4xl sm:text-5xl md:text-6xl text-[#f286aa] drop-shadow-md mb-2 block transform translate-y-6 opacity-0 transition-all duration-700 delay-200">
              {slide.scriptTitle}
            </span>

            <!-- Main Heading in Cormorant Infant -->
            <h1 class="slide-title text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-serif font-bold text-white uppercase tracking-wider leading-[1.05] mb-4 transform translate-y-8 opacity-0 transition-all duration-700 delay-300">
              {slide.heading}
            </h1>

            <!-- Description -->
            <p class="slide-desc max-w-xl text-sm sm:text-base md:text-lg text-gray-200 font-light leading-relaxed mb-8 transform translate-y-8 opacity-0 transition-all duration-700 delay-400">
              {slide.subheading}
            </p>

            <!-- Read more Action Button from original theme -->
            <div class="slide-actions transform translate-y-8 opacity-0 transition-all duration-700 delay-500">
              <a 
                href="/services" 
                class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full border border-white/30 hover:border-[#f286aa] bg-white/5 hover:bg-[#f286aa] text-white hover:text-black font-sans text-xs uppercase tracking-widest font-semibold transition-all duration-300 backdrop-blur-sm cursor-pointer shadow-lg group focus-visible:ring-2 focus-visible:ring-[#f286aa]"
              >
                <span>{slide.cta}</span>
                <i class="fas fa-arrow-right text-[10px] transform group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
              </a>
            </div>
          </div>

        </div>

      </div>
    ))}
  </div>

</section>

<!-- Ken Burns ZoomSlider Animation Styles -->
<style>
  .stroke-text {
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.35);
  }

  .zoom-slide.active .slide-bg-img {
    animation: kenBurnsZoom 7.5s ease-out forwards;
  }

  .zoom-slide.active .slide-script,
  .zoom-slide.active .slide-title,
  .zoom-slide.active .slide-desc,
  .zoom-slide.active .slide-actions {
    transform: translateY(0);
    opacity: 1;
  }

  @keyframes kenBurnsZoom {
    0% {
      transform: scale(1.02);
    }
    100% {
      transform: scale(1.10);
    }
  }
</style>

<script is:inline>
  function setupKenBurnsSlider() {
    const slides = document.querySelectorAll('#zoom-slider-container .zoom-slide');
    const dots = document.querySelectorAll('#vertical-dots .vertical-dot');
    let currentIdx = 0;
    let timer = null;
    const interval = 6500;

    if (!slides.length) return;

    function goToSlide(idx) {
      slides[currentIdx].classList.remove('opacity-100', 'z-10', 'active');
      slides[currentIdx].classList.add('opacity-0', 'z-0', 'pointer-events-none');
      if (dots[currentIdx]) {
        dots[currentIdx].classList.remove('bg-[#f286aa]', 'ring-2', 'ring-[#f286aa]/40');
        dots[currentIdx].classList.add('bg-white/40');
      }

      currentIdx = (idx + slides.length) % slides.length;

      slides[currentIdx].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
      slides[currentIdx].classList.add('opacity-100', 'z-10', 'active');
      if (dots[currentIdx]) {
        dots[currentIdx].classList.remove('bg-white/40');
        dots[currentIdx].classList.add('bg-[#f286aa]', 'ring-2', 'ring-[#f286aa]/40');
      }
    }

    function nextSlide() {
      goToSlide(currentIdx + 1);
    }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(nextSlide, interval);
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goToSlide(i);
        resetTimer();
      });
    });

    timer = setInterval(nextSlide, interval);
  }

  document.addEventListener('DOMContentLoaded', setupKenBurnsSlider);
</script>
