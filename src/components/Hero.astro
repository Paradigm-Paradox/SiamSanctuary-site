---
---

<section class="relative min-h-[85vh] sm:min-h-[90vh] flex items-center justify-center overflow-hidden bg-[#101010]">
  <!-- Background Glow & Imagery -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/uploads/2022/01/serv_01_02.jpg" 
      alt="Dream Nails Hero Artistry" 
      class="w-full h-full object-cover object-center opacity-30 scale-105 filter blur-[1px] transition-transform duration-1000"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#141414]/75 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#141414] via-transparent to-[#141414]"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    
    <!-- Script Calligraphy Accent -->
    <div class="inline-block mb-3 animate-fade-in">
      <span class="font-script text-4xl sm:text-5xl md:text-6xl text-[#f286aa] tracking-normal drop-shadow-md">
        Perfection in Every Brush
      </span>
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-serif font-bold text-white uppercase tracking-wider leading-[1.08] mb-6">
      Trendsetting Nail Artistry <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-[#d9c1a3] to-[#f286aa]">
        & Luxury Spa Sanctuary
      </span>
    </h1>

    <!-- Subtitle / Tagline -->
    <p class="max-w-2xl mx-auto text-base sm:text-lg text-gray-300 font-light leading-relaxed mb-10">
      Experience world-class manicure artistry, gel enhancements, and revitalizing spa pedicures. Where creative expression meets meticulous, hospital-grade sanitation.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <button class="open-booking-modal btn-luxury-primary w-full sm:w-auto text-sm cursor-pointer shadow-xl shadow-[#f286aa]/20">
        <i class="far fa-calendar-check mr-2"></i>
        <span>Book Your Appointment</span>
      </button>
      <a href="#services-menu" class="btn-luxury-outline w-full sm:w-auto text-sm">
        <i class="fas fa-sparkles mr-2 text-[#f286aa]"></i>
        <span>Explore Service Menu</span>
      </a>
      <a href="/shop" class="text-xs uppercase tracking-widest text-[#d9c1a3] hover:text-white transition py-2 px-4 flex items-center gap-2 group">
        <span>Browse Organic Shop</span>
        <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
      </a>
    </div>

    <!-- Trust / Hygiene Badges Banner -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-8 border-t border-white/10 text-left">
      <div class="p-3 bg-white/5 rounded-xl border border-white/5 backdrop-blur-sm">
        <div class="flex items-center gap-2.5">
          <i class="fas fa-shield-virus text-[#f286aa] text-lg"></i>
          <div>
            <div class="text-xs font-semibold text-white uppercase tracking-wider">Hospital-Grade</div>
            <div class="text-[11px] text-gray-400">Sterilized Tool Packs</div>
          </div>
        </div>
      </div>

      <div class="p-3 bg-white/5 rounded-xl border border-white/5 backdrop-blur-sm">
        <div class="flex items-center gap-2.5">
          <i class="fas fa-leaf text-[#42bf80] text-lg"></i>
          <div>
            <div class="text-xs font-semibold text-white uppercase tracking-wider">Eco-Friendly</div>
            <div class="text-[11px] text-gray-400">Natural & Non-Toxic</div>
          </div>
        </div>
      </div>

      <div class="p-3 bg-white/5 rounded-xl border border-white/5 backdrop-blur-sm">
        <div class="flex items-center gap-2.5">
          <i class="fas fa-award text-[#d9c1a3] text-lg"></i>
          <div>
            <div class="text-xs font-semibold text-white uppercase tracking-wider">Master Artists</div>
            <div class="text-[11px] text-gray-400">15+ Yrs International Craft</div>
          </div>
        </div>
      </div>

      <div class="p-3 bg-white/5 rounded-xl border border-white/5 backdrop-blur-sm">
        <div class="flex items-center gap-2.5">
          <i class="fas fa-globe-asia text-[#f286aa] text-lg"></i>
          <div>
            <div class="text-xs font-semibold text-white uppercase tracking-wider">Global Reach</div>
            <div class="text-[11px] text-gray-400">6 International Hubs</div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Scroll Down Pill -->
  <a href="#philosophy" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-gray-500 hover:text-[#f286aa] transition flex flex-col items-center gap-1 text-[10px] uppercase tracking-widest">
    <span>Scroll</span>
    <i class="fas fa-chevron-down animate-bounce text-xs"></i>
  </a>
</section>
