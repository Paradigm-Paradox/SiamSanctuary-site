---
interface Props {
  icon: string;
  class?: string;
  name?: string;
}

const { icon, class: className = "w-4 h-4", name = "" } = Astro.props;
---

{icon === 'custom-red' ? (
  <!-- XiaoHongShu (RED / 小红书) SVG Icon -->
  <svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true">
    <rect x="2" y="3" width="20" height="18" rx="4" fill="none" stroke="currentColor" stroke-width="1.8" />
    <path d="M7 8h3.5c1.4 0 2.5 1 2.5 2.2 0 1.2-1.1 2.2-2.5 2.2H7V8z" fill="none" stroke="currentColor" stroke-width="1.6" />
    <path d="M10.5 12.4L13.2 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <path d="M15 8h2v8h-2M15 12h1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
) : icon === 'custom-lemon8' ? (
  <!-- Lemon8 SVG Icon -->
  <svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true">
    <ellipse cx="12" cy="12.5" rx="7.5" ry="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
    <path d="M12 6c0-2 1.5-3 2.5-3.5-.5 1.5-.2 2.5.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <circle cx="12" cy="12.5" r="2.5" fill="currentColor" />
    <path d="M12 9v1M12 15v1M8.5 12.5h1M14.5 12.5h1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  </svg>
) : (
  <i class={`${icon} ${className} flex items-center justify-center`} aria-hidden="true"></i>
)}
