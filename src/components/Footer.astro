---
import locations from '../data/locations.json';
import socials from '../data/socials.json';
import SocialIcon from './SocialIcon.astro';

const flagConfig: Record<string, { flag: string; countryCode: string; stripes: string; glow: string }> = {
  "san-juan": {
    flag: "🇵🇷",
    countryCode: "PR",
    stripes: "linear-gradient(to bottom, #ed0000 0% 20%, #ffffff 20% 40%, #ed0000 40% 60%, #ffffff 60% 80%, #ed0000 80% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(0, 80, 240, 0.45) 0%, rgba(237, 0, 0, 0.35) 50%, transparent 80%)"
  },
  "mayaguez": {
    flag: "🇵🇷",
    countryCode: "PR",
    stripes: "linear-gradient(to bottom, #ed0000 0% 20%, #ffffff 20% 40%, #ed0000 40% 60%, #ffffff 60% 80%, #ed0000 80% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(0, 80, 240, 0.45) 0%, rgba(237, 0, 0, 0.35) 50%, transparent 80%)"
  },
  "bangkok": {
    flag: "🇹🇭",
    countryCode: "TH",
    stripes: "linear-gradient(to bottom, #a51931 0% 16.6%, #ffffff 16.6% 33.3%, #2d2a4a 33.3% 66.6%, #ffffff 66.6% 83.3%, #a51931 83.3% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(45, 42, 74, 0.55) 0%, rgba(165, 25, 49, 0.4) 50%, transparent 80%)"
  },
  "phuket": {
    flag: "🇹🇭",
    countryCode: "TH",
    stripes: "linear-gradient(to bottom, #a51931 0% 16.6%, #ffffff 16.6% 33.3%, #2d2a4a 33.3% 66.6%, #ffffff 66.6% 83.3%, #a51931 83.3% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(45, 42, 74, 0.55) 0%, rgba(165, 25, 49, 0.4) 50%, transparent 80%)"
  },
  "pattaya": {
    flag: "🇹🇭",
    countryCode: "TH",
    stripes: "linear-gradient(to bottom, #a51931 0% 16.6%, #ffffff 16.6% 33.3%, #2d2a4a 33.3% 66.6%, #ffffff 66.6% 83.3%, #a51931 83.3% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(45, 42, 74, 0.55) 0%, rgba(165, 25, 49, 0.4) 50%, transparent 80%)"
  },
  "chiang-mai": {
    flag: "🇹🇭",
    countryCode: "TH",
    stripes: "linear-gradient(to bottom, #a51931 0% 16.6%, #ffffff 16.6% 33.3%, #2d2a4a 33.3% 66.6%, #ffffff 66.6% 83.3%, #a51931 83.3% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(45, 42, 74, 0.55) 0%, rgba(165, 25, 49, 0.4) 50%, transparent 80%)"
  },
  "hua-hin": {
    flag: "🇹🇭",
    countryCode: "TH",
    stripes: "linear-gradient(to bottom, #a51931 0% 16.6%, #ffffff 16.6% 33.3%, #2d2a4a 33.3% 66.6%, #ffffff 66.6% 83.3%, #a51931 83.3% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(45, 42, 74, 0.55) 0%, rgba(165, 25, 49, 0.4) 50%, transparent 80%)"
  },
  "bali": {
    flag: "🇮🇩",
    countryCode: "ID",
    stripes: "linear-gradient(to bottom, #ce1126 0% 50%, #ffffff 50% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(206, 17, 38, 0.5) 0%, rgba(255, 255, 255, 0.25) 50%, transparent 80%)"
  },
  "dubai": {
    flag: "🇦🇪",
    countryCode: "AE",
    stripes: "linear-gradient(to bottom, #00732f 0% 33.3%, #ffffff 33.3% 66.6%, #000000 66.6% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(0, 115, 47, 0.5) 0%, rgba(255, 0, 0, 0.35) 50%, transparent 80%)"
  },
  "douala": {
    flag: "🇨🇲",
    countryCode: "CM",
    stripes: "linear-gradient(to right, #007a3d 0% 33.3%, #ce1126 33.3% 66.6%, #fcd116 66.6% 100%)",
    glow: "radial-gradient(circle at 80% 20%, rgba(206, 17, 38, 0.5) 0%, rgba(252, 209, 22, 0.35) 50%, transparent 80%)"
  }
};
---

<footer class="bg-[#0b0b0b] border-t border-white/10 pt-16 pb-12 text-gray-400 text-xs select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Brand Statement matching original Atura theme -->
    <div class="mb-14 pb-12 border-b border-white/5 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-3xl space-y-3">
        <a href="/" class="inline-flex items-center gap-3 focus-visible:ring-2 focus-visible:ring-[#f286aa] rounded-lg p-1 mb-2" aria-label="Dream Nails Asia Homepage">
          <img 
            src="/images/2022/04/Dream-Salon-Transparent-BG-02-noborder-1.png" 
            alt="Dream Nails Asia Luxury Nail Sanctuary Logo" 
            class="h-12 w-auto object-contain"
          />
          <div>
            <span class="block text-2xl font-serif text-white tracking-widest uppercase">Dream Nails</span>
            <span class="block text-[10px] tracking-[0.25em] text-[#d9c1a3] uppercase font-sans">Perfection in Every Brush</span>
          </div>
        </a>
        <p class="text-xs sm:text-sm text-gray-300 font-light leading-relaxed italic">
          “Esthetic, cozy, and professional salon experiences are what we want our clients to remember us. We are offering one of the most relaxing and comfortable atmospheres. We are using sanitized equipment, disposable liner, buffer, file, and pumice, cleanness is one of our top priorities besides our client’s satisfaction. <strong class="text-[#f286aa] not-italic font-normal">Come and chill with us.</strong>”
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button class="open-booking-modal btn-luxury-primary text-xs cursor-pointer shadow-xl focus-visible:ring-2 focus-visible:ring-[#f286aa]">
          <i class="far fa-calendar-check mr-1.5" aria-hidden="true"></i>
          <span>Book Appointment</span>
        </button>
      </div>
    </div>

    <!-- Global Salon Hubs Bar matching original WordPress theme layout -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-4">
        <span class="text-[11px] uppercase tracking-[0.25em] text-[#d9c1a3] font-semibold">Global Salon Network</span>
        <span class="text-[10px] text-gray-500 uppercase tracking-wider">Hospital-Grade Sterilization Worldwide</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 sm:gap-4">
        {locations.map((loc) => {
          const flag = flagConfig[loc.slug] || {
            flag: "🌐",
            countryCode: loc.code || "HUB",
            stripes: "linear-gradient(135deg, rgba(242,134,170,0.3), rgba(217,193,163,0.3))",
            glow: "radial-gradient(circle at 80% 20%, rgba(242,134,170,0.4), transparent 70%)"
          };

          return (
            <a 
              href={`/locations/${loc.slug}`}
              class="relative overflow-hidden p-3.5 rounded-xl bg-[#141414] border border-white/5 hover:border-[#f286aa]/50 transition-all duration-300 group hover:-translate-y-1 block shadow-sm hover:shadow-xl"
            >
              <!-- Ambient Flag Gradient Glow in the open space -->
              <div 
                class="absolute -top-6 -right-6 w-32 h-32 rounded-full pointer-events-none opacity-25 group-hover:opacity-55 blur-xl transition-all duration-500 transform group-hover:scale-125"
                style={`background: ${flag.glow};`}
              ></div>

              <!-- Flag Stripes Watermark in the right open space with smooth horizontal fade -->
              <div 
                class="absolute right-0 top-0 bottom-0 w-28 pointer-events-none opacity-15 group-hover:opacity-30 transition-opacity duration-300"
                style={`background: ${flag.stripes}; mask-image: linear-gradient(to left, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.25) 50%, transparent 100%); -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.25) 50%, transparent 100%);`}
              ></div>

              <!-- Card Content -->
              <div class="relative z-10">
                <div class="flex items-start justify-between gap-1.5 mb-1.5">
                  <div class="text-[11px] font-serif text-white uppercase tracking-wider group-hover:text-[#f286aa] transition-colors truncate">
                    {loc.name || `${loc.city}, ${loc.country}`}
                  </div>
                  <!-- Flag & Airport Code Pill in the open space -->
                  <span class="shrink-0 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-black/50 border border-white/10 text-[9px] group-hover:border-white/20 transition-colors shadow-sm">
                    <span class="text-[10px] leading-none">{flag.flag}</span>
                    <span class="font-mono font-bold text-gray-300 group-hover:text-white transition-colors">{loc.code}</span>
                  </span>
                </div>

                <div class="text-[9px] text-[#d9c1a3] tracking-wider uppercase truncate">
                  {loc.badge || "Active Salon Hub"}
                </div>
                <div class="text-[10px] text-gray-500 truncate mt-1 group-hover:text-gray-400 transition-colors">
                  {loc.email}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Main Navigation Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- 1. Safety & Hospital-Grade Protocols -->
      <div>
        <h4 class="text-sm font-serif text-white uppercase tracking-wider mb-4 border-b border-white/10 pb-2 flex items-center justify-between">
          <span>Sanitation Standards</span>
          <span class="text-[9px] text-[#f286aa] font-sans font-semibold tracking-wider uppercase px-1.5 py-0.5 rounded bg-[#f286aa]/10 border border-[#f286aa]/20">Clinical</span>
        </h4>
        <ul class="space-y-2 text-xs text-gray-400">
          <li class="flex items-center gap-2"><i class="fas fa-shield-virus text-[#f286aa]" aria-hidden="true"></i> 275°F Class-B autoclave sterilization</li>
          <li class="flex items-center gap-2"><i class="fas fa-trash text-[#d9c1a3]" aria-hidden="true"></i> 100% single-use buffers, files & liners</li>
          <li class="flex items-center gap-2"><i class="fas fa-water text-[#f286aa]" aria-hidden="true"></i> Pipeless hydrotherapy & ozone basins</li>
          <li class="flex items-center gap-2"><i class="fas fa-spray-can-sparkles text-[#d9c1a3]" aria-hidden="true"></i> EPA hospital broad-spectrum virucides</li>
          <li class="flex items-center gap-2"><i class="fas fa-wind text-[#f286aa]" aria-hidden="true"></i> HEPA-13 air purifiers & dust extraction</li>
          <li class="flex items-center gap-2"><i class="fas fa-certificate text-[#d9c1a3]" aria-hidden="true"></i> Certified master stylists & aestheticians</li>
        </ul>
        <div class="mt-4 pt-3 border-t border-white/5">
          <a href="/sanitation-standards" class="text-[11px] text-[#f286aa] hover:text-white transition flex items-center gap-1.5 font-medium group">
            <span>Explore All 6 Clinical Protocols</span>
            <i class="fas fa-arrow-right text-[9px] group-hover:translate-x-1 transition-transform"></i>
          </a>
        </div>
      </div>

      <!-- 2. Quick Navigation -->
      <div>
        <h4 class="text-sm font-serif text-white uppercase tracking-wider mb-4 border-b border-white/10 pb-2">
          Explore
        </h4>
        <ul class="space-y-2.5">
          <li><a href="/" class="hover:text-[#f286aa] transition">Home</a></li>
          <li><a href="/about-us" class="hover:text-[#f286aa] transition">About Us</a></li>
          <li><a href="/sanitation-standards" class="hover:text-[#f286aa] transition">Sanitation Standards</a></li>
          <li><a href="/services" class="hover:text-[#f286aa] transition">Services Menu</a></li>
          <li><a href="/gallery" class="hover:text-[#f286aa] transition">Artistry Portfolio (79+ Designs)</a></li>
          <li><a href="/news" class="hover:text-[#f286aa] transition">Latest News & Guides</a></li>
          <li><a href="/shop" class="hover:text-[#f286aa] transition">Cosmetics & Care Shop</a></li>
          <li><a href="/testimonials" class="hover:text-[#f286aa] transition">Client Stories & Social Reviews</a></li>
          <li><a href="/contacts" class="hover:text-[#f286aa] transition">Contact & Booking</a></li>
        </ul>
      </div>

      <!-- 3. Operating Hours & Policies -->
      <div>
        <h4 class="text-sm font-serif text-white uppercase tracking-wider mb-4 border-b border-white/10 pb-2">
          Salon Hours
        </h4>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b border-white/5">
            <span>Monday – Friday:</span>
            <span class="text-white font-medium">9:00 AM – 5:00 PM</span>
          </div>
          <div class="flex justify-between py-1 border-b border-white/5">
            <span>Saturday:</span>
            <span class="text-[#f286aa] font-medium">Sanitization Deep Clean</span>
          </div>
          <div class="flex justify-between py-1 border-b border-white/5">
            <span>Sunday:</span>
            <span class="text-white font-medium">9:00 AM – 5:00 PM</span>
          </div>
        </div>
        <p class="text-[11px] text-gray-500 mt-4 leading-relaxed">
          *Walk-ins welcomed subject to stylist and specialist availability. Advance bookings recommended.
        </p>
      </div>

      <!-- 4. Brand & Socials -->
      <div class="space-y-4">
        <h4 class="text-sm font-serif text-white uppercase tracking-wider border-b border-white/10 pb-2 flex items-center justify-between">
          <span>Connect With Us</span>
          <span class="text-[10px] text-[#f286aa] tracking-widest font-sans font-semibold">12 CHANNELS</span>
        </h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">
          Follow our latest salon transformations, seasonal palettes, hair rituals, and beauty masterclasses across our global channels.
        </p>

        <!-- 12 Social Media Badges Grid (Official Logo Pack) -->
        <div class="grid grid-cols-4 sm:grid-cols-6 lg:grid-cols-4 gap-2.5 pt-1">
          {socials.map((s) => (
            <a 
              href={s.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-9 h-9 rounded-xl overflow-hidden shadow-md hover:scale-115 hover:shadow-lg transition-all duration-200 group relative focus-visible:ring-1 focus-visible:ring-[#f286aa] block" 
              aria-label={`Visit Dream Nails on ${s.name}`} 
              title={`${s.name} (${s.handle})`}
            >
              <SocialIcon id={s.id} class="w-full h-full" />
              
              <!-- Luxury Micro-Tooltip -->
              <span class="absolute -top-7 left-1/2 -translate-x-1/2 bg-black/95 text-white text-[9px] font-sans px-2 py-0.5 rounded opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-150 whitespace-nowrap z-30 border border-white/10 shadow-lg">
                {s.name}
              </span>
            </a>
          ))}
        </div>

        <div class="pt-2 text-[11px] text-gray-400 flex items-center gap-2">
          <i class="far fa-envelope text-[#f286aa]"></i>
          <a href="mailto:info@dreamnails.asia" class="hover:text-[#f286aa] transition">info@dreamnails.asia</a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Back to Top -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <div>
        Copyright © 2026 <strong class="text-white">DreamNails.Asia</strong>. All rights reserved.
      </div>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-white transition">Privacy Policy</a>
        <a href="#top" class="hover:text-[#f286aa] transition flex items-center gap-1.5 focus-visible:ring-1 focus-visible:ring-[#f286aa] rounded p-0.5" aria-label="Scroll back to top of page">
          <span>Back to top</span>
          <i class="fas fa-chevron-up text-[10px]" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</footer>
